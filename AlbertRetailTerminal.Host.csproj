<!--
  Development host: run the WPF terminal from the solution root.
  Usage: dotnet run
  Equivalent: dotnet run with project src/PointOfSale.App/PointOfSale.App.csproj
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AlbertRetailTerminal.DevHost</RootNamespace>
    <AssemblyName>AlbertRetailTerminal.DevHost</AssemblyName>
    <Description>Solution-root launcher for Albert Retail Terminal (dotnet run).</Description>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Host\Program.cs" />
  </ItemGroup>

  <Target Name="BuildApp" BeforeTargets="PrepareForRun">
    <MSBuild
      Projects="$(AppProject)"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>
</Project>
