<Window x:Class="PointOfSale.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Albert Retail Terminal"
        Height="900"
        Width="1400"
        MinHeight="720"
        MinWidth="1100"
        Background="#F4F6F8">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2937" Padding="16">
            <StackPanel>
                <TextBlock Text="Albert Retail Terminal"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />
                <Button Content="Checkout"
                        Command="{Binding NavigateCheckoutCommand}"
                        Margin="0,4"
                        Padding="12,10"
                        FontSize="16" />
                <Button Content="Inventory"
                        Command="{Binding NavigateInventoryCommand}"
                        Margin="0,4"
                        Padding="12,10"
                        FontSize="16" />
                <Button Content="Queue Sync"
                        Command="{Binding NavigateQueueCommand}"
                        Margin="0,4"
                        Padding="12,10"
                        FontSize="16" />
                <Button Content="MRA Compliance"
                        Command="{Binding NavigateComplianceCommand}"
                        Margin="0,4"
                        Padding="12,10"
                        FontSize="16" />
                <Button Content="Toggle Drawer"
                        Command="{Binding ToggleDrawerCommand}"
                        Margin="0,16,0,0"
                        Padding="10,8" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="16" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Border Padding="10,6" CornerRadius="8" Margin="0,0,8,0" Background="#2563EB">
                            <TextBlock Text="{Binding ConnectionStatusText}" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <Border Padding="10,6" CornerRadius="8" Background="#4B5563">
                            <TextBlock Text="{Binding IsDrawerOpen, StringFormat='Drawer: {0}'}"
                                       Foreground="White" />
                        </Border>
                        <Button Content="Refresh"
                                Command="{Binding RefreshConnectionCommand}"
                                Margin="8,0,0,0"
                                Padding="10,6" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1"
                            Margin="16"
                            Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
