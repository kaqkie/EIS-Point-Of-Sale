<Window x:Class="PointOfSale.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Albert Retail Terminal"
        Height="900"
        Width="1400"
        MinHeight="720"
        MinWidth="1100"
        Background="{StaticResource Art.Brush.Surface}">
    <Grid>
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Collapsed rail strip (re-open control) -->
            <Border Grid.Column="0"
                    Width="56"
                    Background="{StaticResource Art.Brush.Canvas}"
                    BorderBrush="{StaticResource Art.Brush.Border}"
                    BorderThickness="0,0,1,0"
                    Padding="8"
                    Visibility="{Binding IsNavDrawerCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Top">
                    <Button Content="☰"
                            ToolTip="Expand navigation drawer"
                            Style="{StaticResource Art.Button.Ghost}"
                            Command="{Binding ToggleDrawerCommand}"
                            FontSize="18"
                            Padding="8,10"
                            Margin="0,0,0,8" />
                    <Button Content="↕"
                            ToolTip="Open shift &amp; drawer workspace"
                            Style="{StaticResource Art.Button.Secondary}"
                            Command="{Binding OpenCashierShiftDrawerCommand}"
                            Visibility="{Binding IsCashierShell, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="8,10" />
                </StackPanel>
            </Border>

            <!-- Cashier light rail -->
            <Border Grid.Column="0"
                    Width="252"
                    Background="{StaticResource Art.Brush.Canvas}"
                    BorderBrush="{StaticResource Art.Brush.Border}"
                    BorderThickness="0,0,1,0"
                    Padding="16"
                    Visibility="{Binding IsCashierNavVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Border Background="{StaticResource Art.Brush.AccentSoft}" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                            <TextBlock Text="CASHIER COUNTER"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="{StaticResource Art.Brush.AccentHover}" />
                        </Border>
                        <TextBlock Text="Albert Retail Terminal"
                                   Style="{StaticResource Art.Text.Title}"
                                   FontSize="18"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding OperatorDisplay}"
                                   Style="{StaticResource Art.Text.Subtitle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />
                        <Button Content="Cashier home"
                                Style="{StaticResource Art.Nav.Cashier}"
                                Command="{Binding NavigateCashierHomeCommand}" />
                        <Button Content="Cash Register"
                                Style="{StaticResource Art.Button.Primary}"
                                Command="{Binding NavigateCashierRegisterCommand}"
                                Margin="0,0,0,8"
                                FocusVisualStyle="{x:Null}"
                                Visibility="{Binding CanCheckout, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="{Binding CashRegisterToggleLabel}"
                                Style="{StaticResource Art.Nav.Cashier}"
                                Command="{Binding ToggleCashRegisterModeCommand}"
                                Margin="0,0,0,8" />
                        <Button Content="Shift &amp; drawer"
                                Style="{StaticResource Art.Nav.Cashier}"
                                Command="{Binding OpenCashierShiftDrawerCommand}" />
                        <Button Content="Queue sync"
                                Style="{StaticResource Art.Nav.Cashier}"
                                Command="{Binding NavigateQueueCommand}"
                                Visibility="{Binding CanQueue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Loyalty"
                                Style="{StaticResource Art.Nav.Cashier}"
                                Command="{Binding NavigateLoyaltyCommand}"
                                Visibility="{Binding CanLoyalty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Back Office"
                                Style="{StaticResource Art.Nav.Cashier}"
                                Command="{Binding NavigateAdminHomeCommand}"
                                Visibility="{Binding CanAnalytics, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,8,0,0"
                                ToolTip="Open Admin management console" />
                        <Button Content="{Binding DrawerToggleLabel}"
                                Style="{StaticResource Art.Button.Ghost}"
                                Command="{Binding ToggleDrawerCommand}"
                                Margin="0,16,0,0" />
                    </StackPanel>
                    <Button Content="Sign out"
                            Style="{StaticResource Art.Button.Danger}"
                            Command="{Binding SignOutCommand}"
                            DockPanel.Dock="Bottom"
                            VerticalAlignment="Bottom"
                            Margin="0,16,0,0" />
                </DockPanel>
            </Border>

            <!-- Admin light rail (deep accent header, still light mode) -->
            <Border Grid.Column="0"
                    Width="252"
                    Background="{StaticResource Art.Brush.AdminRail}"
                    Padding="16"
                    Visibility="{Binding IsAdminNavVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#0369A1" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                                <TextBlock Text="ADMIN CONSOLE"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Foreground="White" />
                            </Border>
                            <TextBlock Text="Albert Retail Terminal"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OperatorDisplay}"
                                       Foreground="#E0F2FE"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16" />
                            <Button Content="Admin home"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateAdminHomeCommand}" />
                            <Button Content="Settings"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateAdminSettingsCommand}"
                                    ToolTip="Fiscal VAT, MRA connection, account, and terminal maintenance" />
                            <Button Content="POS Terminal"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateCashierRegisterCommand}"
                                    Visibility="{Binding CanCheckout, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Shift tools"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigatePosWorkspaceCommand}"
                                    Visibility="{Binding CanCheckout, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Inventory"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateInventoryCommand}"
                                    Visibility="{Binding CanInventory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Analytics"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateAnalyticsCommand}"
                                    Visibility="{Binding CanAnalytics, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Users"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateUsersCommand}"
                                    Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="MRA Compliance"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateComplianceCommand}"
                                    Visibility="{Binding CanCompliance, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Compliance Audit"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateComplianceAuditCommand}"
                                    Visibility="{Binding CanCompliance, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Head Office"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateHeadOfficeCommand}"
                                    Visibility="{Binding CanHeadOffice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Backup / DR"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateBackupCommand}"
                                    Visibility="{Binding CanBackup, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Discounts"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateDiscountsCommand}"
                                    Visibility="{Binding CanDiscounts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Stock Alerts"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateStockAlertsCommand}"
                                    Visibility="{Binding CanStockAlerts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Purchase Orders"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigatePurchaseOrdersCommand}"
                                    Visibility="{Binding CanPurchaseOrders, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Goods Receipt"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateGoodsReceiptCommand}"
                                    Visibility="{Binding CanGoodsReceipt, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Supplier Recon"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateSupplierReconCommand}"
                                    Visibility="{Binding CanSupplierRecon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Diagnostics"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateSystemDiagnosticsCommand}"
                                    Visibility="{Binding CanSystemDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Health"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateSystemHealthCommand}"
                                    Visibility="{Binding CanSystemDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="End of Day"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateEndOfDayCommand}"
                                    Visibility="{Binding CanEndOfDay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Fiscal Rollover"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateFiscalRolloverCommand}"
                                    Visibility="{Binding CanFiscalRollover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Terminal Setup"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateTerminalProvisioningCommand}"
                                    Visibility="{Binding CanProvisionTerminal, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Test Runner"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateTestRunnerCommand}"
                                    Visibility="{Binding CanRunIntegrationTests, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Enterprise"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateEnterpriseMaintenanceCommand}"
                                    Visibility="{Binding CanEnterpriseMaintenance, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="DB Maintenance"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateDatabaseMaintenanceCommand}"
                                    Visibility="{Binding CanDatabaseMaintenance, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Hardware"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateHardwareCommand}"
                                    Visibility="{Binding CanHardware, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="POS Terminal"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigatePosTerminalCommand}"
                                    Visibility="{Binding CanCheckout, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Queue Sync"
                                    Style="{StaticResource Art.Nav.Admin}"
                                    Command="{Binding NavigateQueueCommand}"
                                    Visibility="{Binding CanQueue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button Content="Sign out"
                            Style="{StaticResource Art.Button.Danger}"
                            Command="{Binding SignOutCommand}"
                            DockPanel.Dock="Bottom"
                            VerticalAlignment="Bottom"
                            Margin="0,16,0,0" />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource Art.Brush.Canvas}"
                        Padding="16"
                        BorderBrush="{StaticResource Art.Brush.Border}"
                        BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left"
                                Background="{StaticResource Art.Brush.AccentSoft}"
                                CornerRadius="8"
                                Padding="12,6"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentDateTimeText}"
                                       FontFamily="Consolas"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Art.Brush.AccentHover}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Border Padding="10,6" CornerRadius="8" Margin="0,0,8,0"
                                    Background="{StaticResource Art.Brush.Warning}"
                                    Visibility="{Binding HasHealthWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding HealthWarningText}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           MaxWidth="420"
                                           TextWrapping="Wrap" />
                            </Border>
                            <Border Padding="10,6" CornerRadius="8" Margin="0,0,8,0"
                                    Background="{StaticResource Art.Brush.Accent}">
                                <TextBlock Text="{Binding ConnectionStatusText}" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="Refresh"
                                    Style="{StaticResource Art.Button.Secondary}"
                                    Command="{Binding RefreshConnectionCommand}"
                                    Margin="8,0,0,0"
                                    MinWidth="96"
                                    MinHeight="36"
                                    ToolTip="Refresh online/MRA status and reload Cash Register products" />
                            <Button Content="Sign out"
                                    Style="{StaticResource Art.Button.Danger}"
                                    Command="{Binding SignOutCommand}"
                                    Margin="8,0,0,0"
                                    MinWidth="110"
                                    Visibility="{Binding IsAdminShell, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Row="1"
                                Margin="16"
                                Content="{Binding CurrentViewModel}" />
            </Grid>
        </Grid>

        <ContentControl Content="{Binding FirstRunSetup}"
                        Visibility="{Binding ShowFirstRunOverlay, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ContentControl Content="{Binding Activation}"
                        Visibility="{Binding ShowActivationOverlay, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ContentControl Content="{Binding Authentication}"
                        Visibility="{Binding ShowLoginOverlay, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Window>
