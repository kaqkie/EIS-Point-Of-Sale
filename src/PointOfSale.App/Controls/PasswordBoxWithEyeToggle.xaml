<UserControl x:Class="PointOfSale.App.Controls.PasswordBoxWithEyeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="40">
    <Border Background="White"
            BorderBrush="{DynamicResource Art.Brush.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="4,0,4,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="MaskedBox"
                         Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8,8"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         PasswordChanged="MaskedBox_OnPasswordChanged" />

            <TextBox x:Name="PlainBox"
                     Grid.Column="0"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="8,8"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     Visibility="Collapsed"
                     CaretBrush="{DynamicResource Art.Brush.Accent}"
                     TextChanged="PlainBox_OnTextChanged" />

            <Button x:Name="ToggleButton"
                    Grid.Column="1"
                    Width="40"
                    Height="36"
                    Margin="4,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ToggleButton_OnClick"
                    ToolTip="Show password"
                    VerticalAlignment="Center">
                <Grid Width="20" Height="20">
                    <!-- Eye open -->
                    <Path x:Name="EyeOpen"
                          Stretch="Uniform"
                          Fill="{DynamicResource Art.Brush.TextSecondary}"
                          Data="M12 5C7 5 2.73 8.11 1 12.5 2.73 16.89 7 20 12 20s9.27-3.11 11-7.5C21.27 8.11 17 5 12 5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                    <!-- Eye closed / slash -->
                    <Path x:Name="EyeClosed"
                          Stretch="Uniform"
                          Fill="{DynamicResource Art.Brush.Accent}"
                          Visibility="Collapsed"
                          Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75C21.27 8.11 17 5 12 5c-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12.5 2.73 16.89 7 20 12 20c1.52 0 2.98-.29 4.32-.82l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z" />
                </Grid>
            </Button>
        </Grid>
    </Border>
</UserControl>
