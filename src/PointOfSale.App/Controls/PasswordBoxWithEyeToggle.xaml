<UserControl x:Class="PointOfSale.App.Controls.PasswordBoxWithEyeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="40"
             IsKeyboardFocusWithinChanged="OnIsKeyboardFocusWithinChanged">
    <Border Background="{StaticResource Art.Brush.Canvas}"
            BorderBrush="{StaticResource Art.Brush.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="4,0,4,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="MaskedBox"
                         Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8,8"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         Foreground="{StaticResource Art.Brush.TextPrimary}"
                         CaretBrush="{StaticResource Art.Brush.Accent}"
                         PasswordChanged="MaskedBox_OnPasswordChanged" />

            <TextBox x:Name="PlainBox"
                     Grid.Column="0"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="8,8"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     Visibility="Collapsed"
                     Foreground="{StaticResource Art.Brush.TextPrimary}"
                     CaretBrush="{StaticResource Art.Brush.Accent}"
                     TextChanged="PlainBox_OnTextChanged" />

            <!-- Press-and-hold to peek; release / leave remasks immediately. -->
            <Button x:Name="ToggleButton"
                    Grid.Column="1"
                    Width="40"
                    Height="36"
                    Margin="4,0,2,0"
                    Cursor="Hand"
                    Focusable="False"
                    ToolTip="Hold to show password"
                    VerticalAlignment="Center"
                    PreviewMouseLeftButtonDown="ToggleButton_OnPreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="ToggleButton_OnPreviewMouseLeftButtonUp"
                    MouseLeave="ToggleButton_OnMouseLeave"
                    LostMouseCapture="ToggleButton_OnLostMouseCapture"
                    PreviewTouchDown="ToggleButton_OnPreviewTouchDown"
                    PreviewTouchUp="ToggleButton_OnPreviewTouchUp">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{StaticResource Art.Brush.AccentSoft}"
                                CornerRadius="8"
                                Padding="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Art.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid Width="22" Height="22">
                    <!-- Eye open (password is masked — hold to reveal) -->
                    <TextBlock x:Name="EyeOpen"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7B3;"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Art.Brush.AccentHover}"
                               SnapsToDevicePixels="True" />
                    <!-- Eye hide / slash (password currently visible) -->
                    <TextBlock x:Name="EyeClosed"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xED1A;"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Foreground="White"
                               SnapsToDevicePixels="True" />
                </Grid>
            </Button>
        </Grid>
    </Border>
</UserControl>
