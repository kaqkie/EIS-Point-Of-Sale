<UserControl x:Class="PointOfSale.App.Views.CashierDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Background="{StaticResource Art.Brush.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Art.Card}" Margin="0,0,0,10" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Cashier workspace" Style="{StaticResource Art.Text.Title}"
                                   Visibility="{Binding IsFullWorkspaceMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="Cash Register"
                                   Style="{StaticResource Art.Text.Title}"
                                   Visibility="{Binding IsCashRegisterMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="Search items · enter cash received for change · Paid to complete. Cart stays when you switch views."
                                   Style="{StaticResource Art.Text.Subtitle}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding IsCashRegisterMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource Art.Badge.Success}" Margin="0,0,8,0" Padding="8,4">
                            <TextBlock Text="{Binding StatutoryVatPercentLabel}"
                                       Foreground="{StaticResource Art.Brush.Success}"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                        </Border>
                        <Border Background="{StaticResource Art.Brush.AccentSoft}" CornerRadius="8" Padding="8,4">
                            <TextBlock Text="{Binding IsCashDrawerReady, StringFormat='Drawer: {0}'}"
                                       Foreground="{StaticResource Art.Brush.AccentHover}"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Always-visible action feedback (sync / ping / updates / product reload) -->
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        CornerRadius="8"
                        Padding="12,8"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding ToolbarBusyLabel}"
                                   FontWeight="SemiBold"
                                   Foreground="#1D4ED8"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{StaticResource Art.Brush.TextPrimary}" />
                    </DockPanel>
                </Border>

                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="Ping MRA"
                            Style="{StaticResource Art.Button.Ghost}"
                            Command="{Binding PingMraCommand}"
                            Margin="0,0,8,6"
                            MinWidth="96"
                            MinHeight="36"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="Ping Malawi Revenue Authority EIS" />
                    <Button Content="Check updates"
                            Style="{StaticResource Art.Button.Ghost}"
                            Command="{Binding CheckTerminalUpdatesCommand}"
                            Margin="0,0,8,6"
                            MinWidth="120"
                            MinHeight="36"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="Check for Albert Retail Terminal software updates" />
                    <Button Content="Sync APIs"
                            Style="{StaticResource Art.Button.Primary}"
                            Command="{Binding VerifyAndSyncApisCommand}"
                            Margin="0,0,8,6"
                            MinWidth="110"
                            MinHeight="36"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="Ping MRA, sync configs, pull EIS site products, report queue" />
                    <Button Content="Reload products"
                            Style="{StaticResource Art.Button.Secondary}"
                            Command="{Binding ReloadProductsCommand}"
                            Margin="0,0,8,6"
                            MinWidth="130"
                            MinHeight="36"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="Refresh Find item list from local inventory (after Sync APIs)" />
                    <Button Content="Shift tools"
                            Style="{StaticResource Art.Button.Secondary}"
                            Command="{Binding ReturnToFullWorkspaceCommand}"
                            Margin="0,0,8,6"
                            MinWidth="110"
                            MinHeight="36"
                            FontWeight="SemiBold"
                            FocusVisualStyle="{x:Null}"
                            Visibility="{Binding IsCashRegisterMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="Cash Register"
                            Style="{StaticResource Art.Button.Primary}"
                            Command="{Binding ToggleCashRegisterModeCommand}"
                            Margin="0,0,8,6"
                            MinWidth="130"
                            MinHeight="36"
                            FocusVisualStyle="{x:Null}"
                            Visibility="{Binding IsFullWorkspaceMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="Queue"
                            Style="{StaticResource Art.Button.Ghost}"
                            Command="{Binding OpenQueueCommand}"
                            Margin="0,0,8,6"
                            MinHeight="36"
                            FocusVisualStyle="{x:Null}"
                            Visibility="{Binding IsFullWorkspaceMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="Kick drawer"
                            Style="{StaticResource Art.Button.Success}"
                            Command="{Binding KickDrawerCommand}"
                            Margin="0,0,0,6"
                            MinWidth="110"
                            MinHeight="36"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            FocusVisualStyle="{x:Null}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ===== Cash Register terminal layout ===== -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsCashRegisterMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Top-Left: inventory search + cart grid -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="{StaticResource Art.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,10,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Find item" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"
                                       Foreground="{StaticResource Art.Brush.TextSecondary}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Checkout.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Art.TextBox}"
                                         FontSize="16"
                                         MinHeight="44"
                                         Margin="0,0,8,0"
                                         ToolTip="{Binding Checkout.InventorySearchHint}" />
                                <Button Grid.Column="1"
                                        Content="Add"
                                        Style="{StaticResource Art.Pos.PayCash}"
                                        Command="{Binding Checkout.AddSelectedToCartCommand}"
                                        MinWidth="88"
                                        MinHeight="44"
                                        Margin="0,0,8,0" />
                                <Button Grid.Column="2"
                                        Content="Reload"
                                        Style="{StaticResource Art.Button.Secondary}"
                                        Command="{Binding ReloadProductsCommand}"
                                        MinWidth="88"
                                        MinHeight="44"
                                        Margin="0"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                        ToolTip="Reload products from inventory" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Sale:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                                           Foreground="{StaticResource Art.Brush.TextSecondary}" />
                                <ComboBox Width="90"
                                          MinHeight="32"
                                          ItemsSource="{Binding Checkout.SaleTypeOptions}"
                                          SelectedItem="{Binding Checkout.SaleType, Mode=TwoWay}"
                                          ToolTip="B2C walk-in or B2B with buyer TIN" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Checkout.IsBusinessSale, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Checkout.SaleTypeHint}"
                                           FontSize="11"
                                           Foreground="{StaticResource Art.Brush.TextSecondary}"
                                           Margin="0,0,0,6"
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Buyer TIN"
                                                   Style="{StaticResource Art.Text.Caption}"
                                                   Margin="0,0,0,4" />
                                        <TextBox MinHeight="36"
                                                 FontSize="14"
                                                 Style="{StaticResource Art.TextBox}"
                                                 Text="{Binding Checkout.BuyerTin, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Required for B2B — buyer's Malawi TIN (digits)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Buyer name"
                                                   Style="{StaticResource Art.Text.Caption}"
                                                   Margin="0,0,0,4" />
                                        <TextBox MinHeight="36"
                                                 FontSize="14"
                                                 Style="{StaticResource Art.TextBox}"
                                                 Text="{Binding Checkout.BuyerName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Optional business / buyer display name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Authorization Code"
                                                   Style="{StaticResource Art.Text.Caption}"
                                                   Margin="0,0,0,4" />
                                        <TextBox MinHeight="36"
                                                 FontSize="14"
                                                 Style="{StaticResource Art.TextBox}"
                                                 Text="{Binding Checkout.BuyerAuthorizationCode, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Purchase Authorization Code — required by MRA for some B2B buyers" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding Checkout.InventorySearchHint}"
                                       FontSize="11"
                                       Foreground="{StaticResource Art.Brush.TextSecondary}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding Checkout.FilteredProducts}"
                                     SelectedItem="{Binding Checkout.SelectedProduct}"
                                     Height="140"
                                     Margin="0,8,0,0"
                                     BorderBrush="{StaticResource Art.Brush.Border}"
                                     BorderThickness="1"
                                     FontSize="14"
                                     MouseDoubleClick="ProductQuickPick_OnMouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} — {1}  ({2:N2})">
                                                    <Binding Path="ProductCode" />
                                                    <Binding Path="Name" />
                                                    <Binding Path="UnitPrice" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Checkout.CartItems}"
                                  SelectedItem="{Binding Checkout.SelectedCartLine}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  FontSize="15"
                                  BorderBrush="{StaticResource Art.Brush.Border}"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8FAFC"
                                  RowHeight="44"
                                  ColumnHeaderHeight="36"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Description}" Width="*" MinWidth="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N2}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="Price (incl.)" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Discount" Width="130" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2,2">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="MWK"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,4,0"
                                                           Foreground="#64748B"
                                                           FontSize="11" />
                                                <TextBox Tag="LineDiscount"
                                                         Text="{Binding ManualDiscountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="32"
                                                         FontSize="14"
                                                         Padding="6,4"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="Type discount amount in MWK"
                                                         PreviewMouseLeftButtonDown="DiscountTextBox_PreviewMouseLeftButtonDown"
                                                         GotKeyboardFocus="DiscountTextBox_GotKeyboardFocus"
                                                         LostKeyboardFocus="DiscountTextBox_LostKeyboardFocus"
                                                         KeyDown="DiscountTextBox_KeyDown" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="100" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Top-Right: light totals + cash tender + keypad -->
                <DockPanel x:Name="TenderKeypadPanel"
                           Grid.Column="1"
                           Margin="0,0,0,10"
                           Focusable="True">
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource Art.Card}"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Sale summary"
                                       Style="{StaticResource Art.Text.Subtitle}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <DockPanel>
                                <TextBlock Text="Sub total"
                                           Foreground="{StaticResource Art.Brush.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Checkout.CartSubtotal, StringFormat=N2}"
                                           Foreground="{StaticResource Art.Brush.TextPrimary}"
                                           FontSize="15"
                                           FontFamily="{StaticResource Art.Font.Mono}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Text="Line discount (MWK)"
                                       Foreground="{StaticResource Art.Brush.TextSecondary}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="MWK"
                                           Foreground="{StaticResource Art.Brush.TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           FontSize="13" />
                                <TextBox x:Name="CashRegisterDiscountInput"
                                         Grid.Column="1"
                                         Tag="LineDiscount"
                                         Style="{StaticResource Art.TextBox}"
                                         Text="{Binding Checkout.SelectedLineDiscountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="40"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         FontFamily="{StaticResource Art.Font.Mono}"
                                         Padding="10,6"
                                         VerticalContentAlignment="Center"
                                         IsEnabled="{Binding Checkout.HasSelectedCartLine}"
                                         ToolTip="Select a cart line, then type the discount amount in MWK"
                                         PreviewMouseLeftButtonDown="DiscountTextBox_PreviewMouseLeftButtonDown"
                                         GotKeyboardFocus="DiscountTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="DiscountTextBox_LostKeyboardFocus"
                                         KeyDown="DiscountTextBox_KeyDown" />
                            </Grid>
                            <TextBlock Text="{Binding Checkout.CartDiscountTotal, StringFormat='Applied: MWK {0:N2}'}"
                                       Foreground="{StaticResource Art.Brush.Danger}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Select a cart line to edit discount"
                                       Foreground="{StaticResource Art.Brush.TextMuted}"
                                       FontSize="11"
                                       Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Checkout.HasSelectedCartLine}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="VAT"
                                           Foreground="{StaticResource Art.Brush.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Checkout.CartTaxTotal, StringFormat=N2}"
                                           Foreground="{StaticResource Art.Brush.TextPrimary}"
                                           FontSize="15"
                                           FontFamily="{StaticResource Art.Font.Mono}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <Border Background="{StaticResource Art.Brush.AccentSoft}"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="GRAND TOTAL"
                                               Foreground="{StaticResource Art.Brush.AccentHover}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Checkout.CartGrandTotalDigital}"
                                               Foreground="{StaticResource Art.Brush.TextPrimary}"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource Art.Font.Mono}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>

                            <Border Background="#ECFDF5"
                                    BorderBrush="#A7F3D0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Cash received"
                                               Foreground="{StaticResource Art.Brush.TextSecondary}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="MWK"
                                                   Foreground="{StaticResource Art.Brush.TextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   FontSize="13" />
                                        <TextBox x:Name="CashRegisterTenderInput"
                                                 Grid.Column="1"
                                                 Style="{StaticResource Art.TextBox}"
                                                 Text="{Binding Checkout.AmountTenderedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="42"
                                                 FontSize="20"
                                                 FontWeight="Bold"
                                                 FontFamily="{StaticResource Art.Font.Mono}"
                                                 Padding="10,6"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Enter the cash the customer handed over"
                                                 GotKeyboardFocus="TenderTextBox_GotKeyboardFocus"
                                                 KeyDown="TenderTextBox_KeyDown" />
                                        <Button Grid.Column="2"
                                                Content="Exact"
                                                Style="{StaticResource Art.Button.Secondary}"
                                                Command="{Binding Checkout.TenderExactAmountCommand}"
                                                MinWidth="64"
                                                MinHeight="42"
                                                Margin="8,0,0,0"
                                                ToolTip="Set cash received equal to grand total (F5)" />
                                    </Grid>

                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Text="Change due"
                                                   Foreground="{StaticResource Art.Brush.TextSecondary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Checkout.ChangeDue, StringFormat=N2}"
                                                   Foreground="#047857"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   FontFamily="{StaticResource Art.Font.Mono}"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Checkout.TenderShortfall, StringFormat='Short by: {0:N2}'}"
                                               Foreground="{StaticResource Art.Brush.Danger}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding Checkout.HasInsufficientTender, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding Checkout.TenderStatusMessage}"
                                       Foreground="{StaticResource Art.Brush.TextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="{Binding Checkout.PaymentMethod, StringFormat=Payment: {0}}"
                                       Foreground="{StaticResource Art.Brush.TextMuted}"
                                       FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            BorderBrush="{StaticResource Art.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Cash keypad"
                                       Style="{StaticResource Art.Text.Caption}"
                                       FontWeight="SemiBold"
                                       Margin="4,2,4,8" />
                            <UniformGrid Columns="3" Rows="5">
                                <Button Content="7" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="7" />
                                <Button Content="8" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="8" />
                                <Button Content="9" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="9" />
                                <Button Content="4" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="4" />
                                <Button Content="5" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="5" />
                                <Button Content="6" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="6" />
                                <Button Content="1" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="1" />
                                <Button Content="2" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="2" />
                                <Button Content="3" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="3" />
                                <Button Content="." Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="." />
                                <Button Content="0" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadPressCommand}" CommandParameter="0" />
                                <Button Content="⌫" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadBackspaceCommand}" ToolTip="Backspace" />
                                <Button Content="C" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.KeypadClearCommand}" ToolTip="Clear cash received" />
                                <Button Content="Exact" Style="{StaticResource Art.Pos.Keypad}" Command="{Binding Checkout.TenderExactAmountCommand}" FontSize="14" ToolTip="Exact amount (F5)" />
                                <Button Content="OK" Style="{StaticResource Art.Pos.KeypadOk}" Command="{Binding Checkout.KeypadConfirmTenderCommand}" ToolTip="Confirm cash received" />
                            </UniformGrid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- Bottom: payment + workflow + navigation -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{StaticResource Art.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="6">
                        <Button Content="Cash" Style="{StaticResource Art.Pos.PayCash}"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Cash"
                                Click="PaymentMethodButton_OnClick"
                                ToolTip="Cash — enter amount received to calculate change, then Paid" />
                        <Button Content="Credit" Style="{StaticResource Art.Pos.PayCredit}"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Credit"
                                Click="PaymentMethodButton_OnClick" />
                        <Button Content="Other Card" Style="{StaticResource Art.Pos.PayOther}"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Other Card"
                                Click="PaymentMethodButton_OnClick" />
                        <Button Content="Gift Card" Style="{StaticResource Art.Pos.ActionGift}"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Gift Card"
                                Click="PaymentMethodButton_OnClick" />
                        <Button Content="Print" Style="{StaticResource Art.Pos.ActionPrint}"
                                Command="{Binding ReprintLastReceiptCommand}" />
                        <Button Content="Paid" Style="{StaticResource Art.Pos.ActionPaid}"
                                Command="{Binding ProcessPaymentCommand}"
                                ToolTip="Complete sale (F12)" />
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Columns="6" Margin="0,4,0,0">
                        <Button Content="Void" Style="{StaticResource Art.Pos.ActionVoid}"
                                Command="{Binding VoidSelectedCartLineCommand}"
                                ToolTip="Void selected cart line" />
                        <Button Content="Refund" Style="{StaticResource Art.Pos.ActionRefund}"
                                Command="{Binding RequestRefundOverrideCommand}"
                                ToolTip="Supervisor-authorized refund" />
                        <Button Content="Queue" Style="{StaticResource Art.Pos.ActionNav}"
                                Command="{Binding OpenQueueCommand}" />
                        <Button Content="Full Workspace" Style="{StaticResource Art.Pos.ActionNav}"
                                Command="{Binding ReturnToFullWorkspaceCommand}"
                                ToolTip="Open shift tools, split pay, and refunds" />
                        <Button Content="Back Office" Style="{StaticResource Art.Pos.ActionNav}"
                                Command="{Binding OpenBackOfficeCommand}"
                                ToolTip="Open Admin management console" />
                        <Button Content="Admin Menu" Style="{StaticResource Art.Pos.ActionNav}"
                                Command="{Binding OpenBackOfficeCommand}"
                                ToolTip="Open Admin / Back Office"
                                Visibility="{Binding CanOpenBackOffice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Full workspace tabs -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedWorkspaceTab}"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="{Binding IsFullWorkspaceMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TabItem Header="Sales processing">
                <ScrollViewer Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <Grid MinHeight="520">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0" Content="{Binding Checkout}" Margin="0,0,12,0" MinHeight="480" />

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Art.Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Tender &amp; split pay" Style="{StaticResource Art.Text.Title}" FontSize="16" />
                                    <TextBlock Text="Cash / card / mobile / split" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,10" />
                                    <TextBlock Text="Split cash" Style="{StaticResource Art.Text.Caption}" />
                                    <TextBox Text="{Binding SplitCashAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Art.TextBox}" Margin="0,4,0,8" />
                                    <TextBlock Text="Split card / digital" Style="{StaticResource Art.Text.Caption}" />
                                    <TextBox Text="{Binding SplitCardAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Art.TextBox}" Margin="0,4,0,8" />
                                    <Button Content="Apply split tender" Style="{StaticResource Art.Button.Primary}" Command="{Binding ApplySplitTenderCommand}" FocusVisualStyle="{x:Null}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Art.Card}">
                                <StackPanel>
                                    <TextBlock Text="Refund / exchange" Style="{StaticResource Art.Text.Title}" FontSize="16" />
                                    <TextBlock Text="Requires supervisor PIN or password authorization"
                                               Style="{StaticResource Art.Text.Caption}"
                                               Margin="0,0,0,10" />
                                    <TextBlock Text="Amount (MWK)" Style="{StaticResource Art.Text.Caption}" />
                                    <TextBox Text="{Binding RefundAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Art.TextBox}" Margin="0,4,0,8" />
                                    <TextBlock Text="Reason" Style="{StaticResource Art.Text.Caption}" />
                                    <TextBox Text="{Binding RefundReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Art.TextBox}" Margin="0,4,0,8" />
                                    <Button Content="Request supervisor override"
                                            Style="{StaticResource Art.Button.Danger}"
                                            Command="{Binding RequestRefundOverrideCommand}"
                                            FocusVisualStyle="{x:Null}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shift &amp; drawer">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Art.Card}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Open / close shift" Style="{StaticResource Art.Text.Title}" FontSize="16" />
                                <TextBlock Text="{Binding OpenShift.CashierName, StringFormat='Open cashier: {0}', TargetNullValue='No open shift'}"
                                           Style="{StaticResource Art.Text.Subtitle}"
                                           Margin="0,6,0,12" />
                                <TextBlock Text="Opening float (MWK)" Style="{StaticResource Art.Text.Caption}" />
                                <TextBox Text="{Binding OpeningFloat}" Style="{StaticResource Art.TextBox}" Margin="0,4,0,8" />
                                <Button Content="Open shift" Style="{StaticResource Art.Button.Primary}" Command="{Binding OpenShiftCommand}" Margin="0,0,0,10" FocusVisualStyle="{x:Null}" />
                                <TextBlock Text="Closing cash counted" Style="{StaticResource Art.Text.Caption}" />
                                <TextBox Text="{Binding ClosingCashCounted}" Style="{StaticResource Art.TextBox}" Margin="0,4,0,8" />
                                <TextBlock Text="Notes" Style="{StaticResource Art.Text.Caption}" />
                                <TextBox Text="{Binding ShiftNotes}" Style="{StaticResource Art.TextBox}" Margin="0,4,0,8" AcceptsReturn="True" Height="64" TextWrapping="Wrap" />
                                <Button Content="Close shift + Z-report" Style="{StaticResource Art.Button.Success}" Command="{Binding CloseShiftCommand}" FocusVisualStyle="{x:Null}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Art.Card}" Margin="8,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Z-report" Style="{StaticResource Art.Text.Title}" FontSize="16" />
                                    <Button DockPanel.Dock="Right"
                                            Content="Preview"
                                            Style="{StaticResource Art.Button.Secondary}"
                                            Command="{Binding PreviewZReportCommand}"
                                            HorizontalAlignment="Right"
                                            FocusVisualStyle="{x:Null}" />
                                </DockPanel>
                                <TextBox Text="{Binding ZReportPreview}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="220"
                                         FontFamily="{StaticResource Art.Font.Mono}"
                                         Style="{StaticResource Art.TextBox}" />
                                <Button Content="Refresh shift status"
                                        Style="{StaticResource Art.Button.Ghost}"
                                        Command="{Binding RefreshShiftCommand}"
                                        Margin="0,12,0,0"
                                        FocusVisualStyle="{x:Null}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
