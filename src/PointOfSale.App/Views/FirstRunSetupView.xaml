<UserControl x:Class="PointOfSale.App.Views.FirstRunSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0F9FF" Offset="0" />
                <GradientStop Color="#FFFFFF" Offset="0.45" />
                <GradientStop Color="#ECFDF5" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="440" Height="440" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-140,-100,0,0" Fill="#BAE6FD" Opacity="0.5" />
        <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-120,-100" Fill="#A7F3D0" Opacity="0.45" />

        <Border Style="{StaticResource Art.Card}"
                Width="560"
                MaxHeight="680"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource Art.Brush.AccentSoft}"
                            CornerRadius="12"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14">
                        <TextBlock Text="FIRST-RUN SETUP"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{StaticResource Art.Brush.AccentHover}" />
                    </Border>

                    <TextBlock Text="Albert Retail Terminal"
                               Style="{StaticResource Art.Text.Hero}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Store manager onboarding — terminal identity, MRA EIS endpoint, and license activation."
                               Style="{StaticResource Art.Text.Subtitle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <TextBlock Text="{Binding StepCaption}"
                               Style="{StaticResource Art.Text.Caption}"
                               Margin="0,0,0,14" />

                    <!-- Step 0: Infrastructure -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WizardStep}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Local database bootstrap"
                                   Style="{StaticResource Art.Text.Title}"
                                   FontSize="18"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding InfrastructureSummary}"
                                   Style="{StaticResource Art.Text.Subtitle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Default operators (admin / cashier) and statutory 17.5% VAT are seeded automatically when SQL Express or LocalDB is reachable."
                                   Style="{StaticResource Art.Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <Button Content="Retry SQL detection"
                                Style="{StaticResource Art.Button.Secondary}"
                                Command="{Binding RetryInfrastructureCommand}"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    </StackPanel>

                    <!-- Step 1: Terminal / branch -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Terminal &amp; branch"
                                   Style="{StaticResource Art.Text.Title}"
                                   FontSize="18"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Terminal display name" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TerminalDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 Margin="0,0,0,12" />
                        <TextBlock Text="Branch / outlet ID" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding BranchId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 Margin="0,0,0,12" />
                        <TextBlock Text="Site ID (optional)" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SiteId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}" />
                    </StackPanel>

                    <!-- Step 2: MRA environment -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="MRA EIS environment"
                                   Style="{StaticResource Art.Text.Title}"
                                   FontSize="18"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Sandbox is for certification drills. Production talks to live MRA EIS APIs."
                                   Style="{StaticResource Art.Text.Subtitle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding MraEnvironmentOptions}"
                                  SelectedItem="{Binding MraEnvironment}"
                                  MinHeight="40"
                                  Padding="8,6" />
                    </StackPanel>

                    <!-- Step 3: License Activation & Finalization -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WizardStep}" Value="3">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="License activation &amp; finalization"
                                   Style="{StaticResource Art.Text.Title}"
                                   FontSize="18"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Enter the activation key, then choose Finish setup. Next is hidden on this final step so you cannot loop past activation."
                                   Style="{StaticResource Art.Text.Subtitle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Activation key" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,4">
                            <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Art.TextBox.LicenseKey}"
                                     MaxLength="19"
                                     CharacterCasing="Upper" />
                            <TextBlock Text="{Binding LicenseKeyPlaceholder}"
                                       FontFamily="{StaticResource Art.Font.Mono}"
                                       FontSize="18"
                                       Foreground="{StaticResource Art.Brush.TextMuted}"
                                       Opacity="0.55"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsLicenseKeyEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Text="{Binding LicenseKeyFormatFeedback}"
                                   Style="{StaticResource Art.Text.Caption}"
                                   Foreground="{StaticResource Art.Brush.Danger}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasLicenseKeyFormatError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding LicenseKeyFormatFeedback}"
                                   Style="{StaticResource Art.Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding IsLicenseKeyIncomplete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <DockPanel>
                            <TextBlock Text="{Binding SampleLicenseHint, StringFormat='Example: {0}'}"
                                       Style="{StaticResource Art.Text.Caption}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Content="Use sample"
                                    Style="{StaticResource Art.Button.Ghost}"
                                    Command="{Binding PasteSampleLicenseCommand}"
                                    Padding="12,6"
                                    MinHeight="34"
                                    HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource Art.Text.Subtitle}"
                               TextWrapping="Wrap"
                               Margin="0,18,0,16" />

                    <!-- Phase 40: dynamic stepper actions — Next collapsed on final; Finish promoted -->
                    <DockPanel LastChildFill="False">
                        <Button Content="Back"
                                Style="{StaticResource Art.Button.Ghost}"
                                Command="{Binding PreviousStepCommand}"
                                DockPanel.Dock="Left"
                                MinWidth="100"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Next"
                                    Style="{StaticResource Art.Button.Secondary}"
                                    Command="{Binding NextStepCommand}"
                                    MinWidth="100"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding IsNextButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanGoNext}" />
                            <Button Content="Finish setup"
                                    Style="{StaticResource Art.Button.Success}"
                                    Command="{Binding FinishCommand}"
                                    MinWidth="180"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Padding="20,12"
                                    Visibility="{Binding IsFinishButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanFinish}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
