<UserControl x:Class="PointOfSale.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PointOfSale.App.Controls">
    <Grid Background="{StaticResource Art.Brush.Surface}">
        <Border Style="{StaticResource Art.Card}"
                Width="420"
                Padding="28"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Albert Retail Terminal"
                           Style="{StaticResource Art.Text.Title}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Legacy operator sign-in"
                           Style="{StaticResource Art.Text.Subtitle}"
                           Margin="0,0,0,16" />

                <TextBlock Text="Username" Style="{StaticResource Art.Text.Caption}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Art.TextBox}"
                         Margin="0,4,0,12" />

                <TextBlock Text="Password" Style="{StaticResource Art.Text.Caption}" />
                <controls:PasswordBoxWithEyeToggle Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Margin="0,4,0,12" />

                <Button Content="Sign In"
                        Style="{StaticResource Art.Button.Primary}"
                        Command="{Binding SignInCommand}"
                        Margin="0,8,0,12" />

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Art.Text.Subtitle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
