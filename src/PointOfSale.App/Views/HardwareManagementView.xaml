<UserControl x:Class="PointOfSale.App.Views.HardwareManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Hardware &amp; Multi-Terminal Sync"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="#4B5563"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    <Button Content="Test Print"
                            Command="{Binding TestPrintCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0"
                            FontWeight="Bold"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    <Button Content="Kick Drawer"
                            Command="{Binding KickCashDrawerCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    <Button Content="Reconnect"
                            Command="{Binding ReconnectPeripheralsCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    <Button Content="Sync Terminals"
                            Command="{Binding SyncTerminalsNowCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            FontWeight="Bold"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Printer" Foreground="#6B7280" />
                        <TextBlock Text="{Binding IsPrinterConnected, StringFormat='Connected: {0}'}"
                                   FontSize="18"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding LastPeripheralCheckTimestamp, StringFormat=g, TargetNullValue=Never checked}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Cash drawer" Foreground="#6B7280" />
                        <TextBlock Text="{Binding IsCashDrawerReady, StringFormat='Ready: {0}'}"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Scanner" Foreground="#6B7280" />
                        <TextBlock Text="{Binding ScannerStatus}"
                                   FontSize="18"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding LastScannedBarcode, StringFormat='Last: {0}', TargetNullValue='Last: —'}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Last peripheral error" Foreground="#6B7280" />
                        <TextBlock Text="{Binding LastHardwareError, TargetNullValue=None}"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Background="#ECFDF5" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="This terminal" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LocalTerminalId}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BranchId, StringFormat='Branch: {0}'}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Online registers" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OnlineTerminalCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Pending ledger" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PendingLedgerCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FEE2E2" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Offline invoices (store)" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PendingOfflineInvoices}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding MultiTerminalStatus}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Register heartbeats (shared store database)"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding PeerTerminals}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              MinHeight="160"
                              MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Terminal" Binding="{Binding TerminalId}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="120" />
                            <DataGridTextColumn Header="Last seen (UTC)" Binding="{Binding LastSeenUtc, StringFormat=g}" Width="150" />
                            <DataGridTextColumn Header="Cashier" Binding="{Binding OpenShiftCashier}" Width="120" />
                            <DataGridTextColumn Header="Expected cash" Binding="{Binding OpenShiftExpectedCash, StringFormat=N2}" Width="110" />
                            <DataGridTextColumn Header="Pending invoices" Binding="{Binding PendingOfflineInvoices}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Supervisor diagnostic log"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding RecentMessages}"
                             MinHeight="180"
                             MaxHeight="300"
                             BorderThickness="0" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
