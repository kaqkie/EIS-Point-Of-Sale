<UserControl x:Class="PointOfSale.App.Views.CustomerLoyaltyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Customer Loyalty"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Padding="12,8"
                        MinHeight="40" />
            </DockPanel>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Member lookup" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox Text="{Binding CustomerSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             Margin="0,0,0,8"
                             Padding="8,6" />
                    <UniformGrid Columns="2">
                        <Border Background="#ECFDF5" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Available points" Foreground="#6B7280" />
                                <TextBlock Text="{Binding AvailablePoints, StringFormat=N2}"
                                           FontSize="22"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Selected member" Foreground="#6B7280" />
                                <TextBlock Text="{Binding SelectedMember.FullName, TargetNullValue=None}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedMember.MemberCode, TargetNullValue=''}"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Search results" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding SearchResults}"
                                  SelectedItem="{Binding SelectedMember}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding MemberCode}" Width="120" />
                                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110" />
                                <DataGridTextColumn Header="Points" Binding="{Binding PointsBalance, StringFormat=N2}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Point ledger" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Ledger}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="130" />
                                <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="80" />
                                <DataGridTextColumn Header="Points" Binding="{Binding Points, StringFormat=N2}" Width="70" />
                                <DataGridTextColumn Header="MWK" Binding="{Binding AmountMwk, StringFormat=N2}" Width="80" />
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Enroll member" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <StackPanel Width="200" Margin="0,0,12,8">
                            <TextBlock Text="Full name" />
                            <TextBox Text="{Binding EnrollName, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,12,8">
                            <TextBlock Text="Phone" />
                            <TextBox Text="{Binding EnrollPhone, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,12,8">
                            <TextBlock Text="Member code (optional)" />
                            <TextBox Text="{Binding EnrollCode, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <Button Content="Enroll"
                                Command="{Binding EnrollCommand}"
                                MinHeight="40"
                                Padding="12,8"
                                Margin="0,16,0,8"
                                VerticalAlignment="Bottom" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
