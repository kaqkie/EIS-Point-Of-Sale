<UserControl x:Class="PointOfSale.App.Views.SupplierInvoiceReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <DockPanel Margin="8" LastChildFill="True">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsReconciling, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Reconcile"
                            Command="{Binding ReconcileCommand}"
                            IsEnabled="{Binding IsReconciling, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold" />
                    <Button Content="AP sign-off"
                            Command="{Binding SignOffCommand}"
                            IsEnabled="{Binding IsReconciling, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Supplier Invoice Reconciliation"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Invoice match form + notes -->
            <Border DockPanel.Dock="Top"
                    Background="White"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Invoice to match"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="200" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="130" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="130" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Posted GRN" Margin="0,0,0,4" Foreground="#374151" />
                            <ComboBox ItemsSource="{Binding PostedGrns}"
                                      SelectedItem="{Binding SelectedGrn}"
                                      DisplayMemberPath="GrnNumber"
                                      MinHeight="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Supplier invoice #" Margin="0,0,0,4" Foreground="#374151" />
                            <TextBox Text="{Binding SupplierInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Padding="8,6"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Invoice date" Margin="0,0,0,4" Foreground="#374151" />
                            <DatePicker SelectedDate="{Binding InvoiceDate}"
                                        MinHeight="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Invoice total (MWK)" Margin="0,0,0,4" Foreground="#374151" />
                            <TextBox Text="{Binding InvoiceTotalMwk, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36"
                                     Padding="8,6"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#FEF3C7"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Discrepancy notes"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"
                                       Foreground="#92400E" />
                            <TextBox Text="{Binding DiscrepancyNotes, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="48"
                                     MaxHeight="96"
                                     Padding="8"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Results: reconciliations then discrepancy lines -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Reconciliations"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Reconciliations}"
                                  SelectedItem="{Binding SelectedReconciliation}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F9FAFB"
                                  BorderThickness="0"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding ReconciliationId}" Width="56" />
                                <DataGridTextColumn Header="GRN" Binding="{Binding GrnNumber}" Width="140" />
                                <DataGridTextColumn Header="Invoice" Binding="{Binding SupplierInvoiceNumber}" Width="120" />
                                <DataGridTextColumn Header="Inv total" Binding="{Binding InvoiceTotalMwk, StringFormat=N2}" Width="100" />
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedTotalMwk, StringFormat=N2}" Width="100" />
                                <DataGridTextColumn Header="Variance" Binding="{Binding VarianceMwk, StringFormat=N2}" Width="100" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Discrepancy lines"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding DiscrepancyLines}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F9FAFB"
                                  BorderThickness="0"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding DiscrepancyType}" Width="120" />
                                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="100" />
                                <DataGridTextColumn Header="Ordered" Binding="{Binding OrderedQty, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedQty, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Damaged" Binding="{Binding DamagedQty, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </ScrollViewer>
</UserControl>
