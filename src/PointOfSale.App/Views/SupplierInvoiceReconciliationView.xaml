<UserControl x:Class="PointOfSale.App.Views.SupplierInvoiceReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Supplier Invoice Reconciliation"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsReconciling, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Reconcile"
                            Command="{Binding ReconcileCommand}"
                            IsEnabled="{Binding IsReconciling, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold" />
                    <Button Content="AP sign-off"
                            Command="{Binding SignOffCommand}"
                            IsEnabled="{Binding IsReconciling, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40" />
                </StackPanel>
            </DockPanel>

            <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Discrepancy notes" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding DiscrepancyNotes, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="60"
                             Padding="8" />
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <WrapPanel>
                    <StackPanel Width="260" Margin="0,0,12,8">
                        <TextBlock Text="Posted GRN" />
                        <ComboBox ItemsSource="{Binding PostedGrns}"
                                  SelectedItem="{Binding SelectedGrn}"
                                  DisplayMemberPath="GrnNumber"
                                  MinHeight="36" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,12,8">
                        <TextBlock Text="Supplier invoice #" />
                        <TextBox Text="{Binding SupplierInvoiceNumber, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,12,8">
                        <TextBlock Text="Invoice date" />
                        <DatePicker SelectedDate="{Binding InvoiceDate}" MinHeight="36" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,12,8">
                        <TextBlock Text="Invoice total (MWK)" />
                        <TextBox Text="{Binding InvoiceTotalMwk, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Reconciliations" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Reconciliations}"
                                  SelectedItem="{Binding SelectedReconciliation}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding ReconciliationId}" Width="50" />
                                <DataGridTextColumn Header="GRN" Binding="{Binding GrnNumber}" Width="120" />
                                <DataGridTextColumn Header="Invoice" Binding="{Binding SupplierInvoiceNumber}" Width="100" />
                                <DataGridTextColumn Header="Inv total" Binding="{Binding InvoiceTotalMwk, StringFormat=N2}" Width="80" />
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedTotalMwk, StringFormat=N2}" Width="80" />
                                <DataGridTextColumn Header="Variance" Binding="{Binding VarianceMwk, StringFormat=N2}" Width="80" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Discrepancy lines" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding DiscrepancyLines}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding DiscrepancyType}" Width="110" />
                                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="80" />
                                <DataGridTextColumn Header="Ordered" Binding="{Binding OrderedQty, StringFormat=N2}" Width="70" />
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedQty, StringFormat=N2}" Width="70" />
                                <DataGridTextColumn Header="Damaged" Binding="{Binding DamagedQty, StringFormat=N2}" Width="70" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
