<UserControl x:Class="PointOfSale.App.Views.DatabaseMaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Database Maintenance"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsEnabled="{Binding IsMaintenanceRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        MinHeight="40" />
            </DockPanel>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Database size" Foreground="#6B7280" />
                        <TextBlock Text="{Binding DatabaseSizeMb, StringFormat={}{0} MB}"
                                   FontSize="20"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FFFBEB" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Fragmented indexes" Foreground="#6B7280" />
                        <TextBlock Text="{Binding FragmentedIndexesCount}"
                                   FontSize="20"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#F0FDF4" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Last optimization" Foreground="#6B7280" />
                        <TextBlock Text="{Binding LastOptimizationTimestamp}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Maintenance tasks"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,16">
                <Button Content="Full optimization"
                        Command="{Binding RunFullOptimizationCommand}"
                        IsEnabled="{Binding IsMaintenanceRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40"
                        FontWeight="SemiBold" />
                <Button Content="Rebuild indexes"
                        Command="{Binding RebuildIndexesCommand}"
                        IsEnabled="{Binding IsMaintenanceRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
                <Button Content="Update statistics"
                        Command="{Binding UpdateStatisticsCommand}"
                        IsEnabled="{Binding IsMaintenanceRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
                <Button Content="Purge telemetry"
                        Command="{Binding PurgeTelemetryCommand}"
                        IsEnabled="{Binding IsMaintenanceRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
            </WrapPanel>

            <TextBlock Text="Maintenance log"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding LogEntries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      MinHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding ExecutedAtLocal}" Width="140" />
                    <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="140" />
                    <DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="40" />
                    <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="50" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
