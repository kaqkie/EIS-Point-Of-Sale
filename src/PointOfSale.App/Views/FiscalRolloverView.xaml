<UserControl x:Class="PointOfSale.App.Views.FiscalRolloverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Fiscal Year Rollover &amp; Archives"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding RolloverStatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CurrentFiscalYear, StringFormat=Current fiscal year: {0}}"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBox Text="{Binding SelectedFiscalYear, UpdateSourceTrigger=PropertyChanged}"
                             Width="80"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             ToolTip="Fiscal year to roll over" />
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsArchivingInProgress, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Year-end close"
                            Command="{Binding ExecuteYearEndRolloverCommand}"
                            IsEnabled="{Binding IsArchivingInProgress, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold" />
                    <Button Content="Archive stale data"
                            Command="{Binding ArchiveStaleDataCommand}"
                            IsEnabled="{Binding IsArchivingInProgress, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Preview gross (MWK)" Foreground="#6B7280" />
                        <TextBlock Text="{Binding PreviewGrossMwk, StringFormat=N2}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#ECFDF5" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Preview VAT (MWK)" Foreground="#6B7280" />
                        <TextBlock Text="{Binding PreviewVatMwk, StringFormat=N2}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FEF3C7" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="EOD closures" Foreground="#6B7280" />
                        <TextBlock FontWeight="Bold">
                            <Run Text="{Binding PreviewClosedDays, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding PreviewExpectedDays, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding CanExecuteRollover, StringFormat=Rollover ready: {0}}" FontSize="12" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Dual-key supervisor authorization"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Foreground="#B45309"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding RequiresSupervisorAuthorization, Converter={StaticResource BooleanToVisibilityConverter}}">
                        Secondary supervisor sign-off and both archive passwords are required before rollover or archival.
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Secondary supervisor username" />
                            <TextBox Text="{Binding SecondarySupervisorUsername, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Padding="8,6" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="Secondary supervisor password" />
                            <PasswordBox x:Name="SecondarySupervisorPasswordBox"
                                         MinHeight="36"
                                         Padding="8,6"
                                         PasswordChanged="SecondarySupervisorPasswordBox_OnPasswordChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Primary archive password" />
                            <PasswordBox x:Name="PrimaryArchivePasswordBox"
                                         MinHeight="36"
                                         Padding="8,6"
                                         PasswordChanged="PrimaryArchivePasswordBox_OnPasswordChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="Secondary archive password" />
                            <PasswordBox x:Name="SecondaryArchivePasswordBox"
                                         MinHeight="36"
                                         Padding="8,6"
                                         PasswordChanged="SecondaryArchivePasswordBox_OnPasswordChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="Rollover notes" />
                            <TextBox Text="{Binding RolloverNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="64"
                                     Padding="8" />
                            <CheckBox Content="Allow rollover with missing daily EOD closures (override)"
                                      IsChecked="{Binding AllowClosureGapsOverride}"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding HasMissingClosureDates, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Missing daily closures" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding MissingClosureDates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=d}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Locked fiscal years" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding YearArchives}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FY" Binding="{Binding FiscalYear}" Width="60" />
                                <DataGridTextColumn Header="Gross" Binding="{Binding TotalGrossSalesMwk, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="VAT" Binding="{Binding TotalVatCollectedMwk, StringFormat=N2}" Width="80" />
                                <DataGridTextColumn Header="Days" Binding="{Binding ClosedDays}" Width="50" />
                                <DataGridTextColumn Header="Locked" Binding="{Binding RolledOverAtUtc, StringFormat=g}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Archive packages" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding ArchivePackages}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding PackageType}" Width="120" />
                                <DataGridTextColumn Header="MB" Binding="{Binding FileBytes}" Width="70" />
                                <DataGridTextColumn Header="By" Binding="{Binding TriggeredByUsername}" Width="80" />
                                <DataGridTextColumn Header="When" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
