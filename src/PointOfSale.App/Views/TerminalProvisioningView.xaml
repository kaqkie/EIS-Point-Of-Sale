<UserControl x:Class="PointOfSale.App.Views.TerminalProvisioningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8" MaxWidth="720">
            <TextBlock Text="Terminal provisioning"
                       FontSize="22"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding ActivationStatus}"
                       TextWrapping="Wrap"
                       Foreground="#4B5563"
                       Margin="0,8,0,16" />

            <Border Background="#FEF3C7"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsProvisioned, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Text="This terminal is provisioned. Fiscal credentials are stored with Windows DPAPI." />
            </Border>

            <Border Background="#FEE2E2"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HardwareBindingValid}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock TextWrapping="Wrap"
                           Text="Hardware binding failed. This package may have been copied from another PC." />
            </Border>

            <UniformGrid Columns="2" Margin="0,0,0,12">
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SQL Express" Foreground="#6B7280" />
                        <TextBlock FontWeight="Bold"
                                   Text="{Binding SqlExpressReachable, StringFormat=Reachable: {0}}" />
                    </StackPanel>
                </Border>
                <Border Background="#ECFDF5" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Provisioned" Foreground="#6B7280" />
                        <TextBlock FontWeight="Bold"
                                   Text="{Binding IsProvisioned, StringFormat=Active: {0}}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Store identity" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Taxpayer TIN (MRA)" />
                    <TextBox Text="{Binding TaxpayerTinInput, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             Padding="8,6"
                             Margin="0,0,0,8" />
                    <TextBlock Text="Branch ID" />
                    <TextBox Text="{Binding BranchIdInput, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             Padding="8,6"
                             Margin="0,0,0,8" />
                    <TextBlock Text="Site ID" />
                    <TextBox Text="{Binding SiteIdInput, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             Padding="8,6"
                             Margin="0,0,0,8" />
                    <TextBlock Text="Expected terminal ID (optional)" />
                    <TextBox Text="{Binding TerminalIdInput, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36"
                             Padding="8,6"
                             IsEnabled="{Binding IsProvisioned, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="MRA activation code (TAC)" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <PasswordBox x:Name="TerminalActivationCodeBox"
                                 MinHeight="36"
                                 Padding="8,6"
                                 IsEnabled="{Binding IsProvisioned, Converter={StaticResource InverseBooleanConverter}}"
                                 PasswordChanged="TerminalActivationCodeBox_OnPasswordChanged" />
                    <TextBlock Text="Device hardware fingerprint (SHA-256)"
                               Margin="0,12,0,4"
                               Foreground="#6B7280" />
                    <TextBox Text="{Binding HardwareFingerprint, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Background="#F9FAFB"
                             Padding="8,6" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh"
                        Command="{Binding RefreshStateCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        MinHeight="40"
                        Margin="0,0,8,0" />
                <Button Content="Prepare deployment"
                        Command="{Binding PrepareDeploymentCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        MinHeight="40"
                        Margin="0,0,8,0" />
                <Button Content="Activate with MRA"
                        Command="{Binding ActivateMraTerminalCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        MinHeight="40"
                        FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
