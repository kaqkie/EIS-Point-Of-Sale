<UserControl x:Class="PointOfSale.App.Views.ComplianceExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="MRA EIS Compliance Certification"
                       FontSize="22"
                       FontWeight="Bold" />
            <TextBlock Text="Run the mandatory MRA certification scenarios, write Logs/MraCertificationAudit.json, and package a regulatory handoff ZIP."
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Foreground="#4B5563" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Margin="0,0,0,12" />
                <TextBlock Text="{Binding OverallResult, StringFormat='Overall result: {0}'}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding LastPackagePath, StringFormat='Last package: {0}'}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Foreground="#2563EB" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Run Certification + Export"
                            Command="{Binding RunCertificationAndExportCommand}"
                            MinHeight="48"
                            MinWidth="220"
                            Padding="14,10"
                            FontSize="16"
                            FontWeight="Bold"
                            Margin="0,0,8,0" />
                    <Button Content="Export Package Only"
                            Command="{Binding ExportOnlyCommand}"
                            MinHeight="48"
                            MinWidth="180"
                            Padding="14,10"
                            FontSize="16" />
                </StackPanel>

                <ProgressBar Height="6"
                             Margin="0,14,0,0"
                             IsIndeterminate="{Binding IsExporting}"
                             Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#111827" CornerRadius="8" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Real-time operator log"
                           Foreground="#9CA3AF"
                           Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding StatusLog}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#E5E7EB"
                         FontFamily="Consolas"
                         FontSize="13"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="#6B7280"
                   TextWrapping="Wrap"
                   Text="Package location: Documents\AlbertRetailTerminal\CompliancePackages\MraCompliancePackage_[TerminalId]_[DateTime].zip" />
    </Grid>
</UserControl>
