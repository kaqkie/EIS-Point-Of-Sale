<UserControl x:Class="PointOfSale.App.Views.ComplianceAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Compliance Audit"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding EffectiveEndpoint}"
                               FontSize="12"
                               Foreground="#6B7280"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        MinHeight="40" />
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F3F4F6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiveProductionActive}" Value="True">
                                    <Setter Property="Background" Value="#ECFDF5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Live production" Foreground="#6B7280" />
                        <TextBlock Text="{Binding IsLiveProductionActive}" FontWeight="Bold" FontSize="18" />
                    </StackPanel>
                </Border>
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Certificate expires" Foreground="#6B7280" />
                        <TextBlock Text="{Binding CertificateExpirationDate}" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="#FFFBEB" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Last MRA sync" Foreground="#6B7280" />
                        <TextBlock Text="{Binding LastSuccessfulMraSync}" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="8" Padding="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F0FDF4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TamperCheckStatus}" Value="{x:Null}">
                                    <Setter Property="Background" Value="#FEE2E2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Tamper check" Foreground="#6B7280" />
                        <TextBlock Text="{Binding TamperCheckStatus}" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Supervisor actions"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,16">
                <Button Content="Activate production handshake"
                        Command="{Binding ActivateProductionCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
                <Button Content="Renew certificate"
                        Command="{Binding RenewCertificateCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
                <Button Content="Validate chain"
                        Command="{Binding ValidateCertificateCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
                <Button Content="Export statutory log"
                        Command="{Binding ExportLogsCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40"
                        FontWeight="SemiBold" />
            </WrapPanel>

            <TextBlock Text="Tamper-evident audit trail"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding AuditRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      MinHeight="260">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding CreatedAtLocal}" Width="140" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="140" />
                    <DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="40" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
