<UserControl x:Class="PointOfSale.App.Views.TestRunnerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Integration test runner"
                       FontSize="22"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding ExecutionStatus}"
                       TextWrapping="Wrap"
                       Foreground="#4B5563"
                       Margin="0,8,0,12" />

            <ProgressBar Value="{Binding ProgressPercent}"
                         Maximum="100"
                         Height="8"
                         Margin="0,0,0,12" />

            <UniformGrid Columns="2" Margin="0,0,0,12">
                <Border Background="#ECFDF5" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Passed" Foreground="#6B7280" />
                        <TextBlock Text="{Binding PassCount}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FEE2E2" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Failed" Foreground="#6B7280" />
                        <TextBlock Text="{Binding FailCount}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Run sandbox suite"
                        Command="{Binding RunSandboxSuiteCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        MinHeight="40"
                        Margin="0,0,8,0"
                        FontWeight="SemiBold" />
                <Button Content="Run dotnet integration tests"
                        Command="{Binding RunFullDotNetSuiteCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        MinHeight="40"
                        Margin="0,0,8,0" />
                <Button Content="Compliance readiness report"
                        Command="{Binding GenerateComplianceReportCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        MinHeight="40" />
            </StackPanel>

            <DataGrid ItemsSource="{Binding TestSuitesList}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      MaxHeight="220"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scenario" Binding="{Binding Name}" Width="*" />
                    <DataGridCheckBoxColumn Header="Pass" Binding="{Binding Passed}" Width="60" />
                    <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="60" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Message}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Failure log" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Text="{Binding FailureLogOutput, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Height="160"
                     FontFamily="Consolas"
                     Background="#F9FAFB"
                     Padding="8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
