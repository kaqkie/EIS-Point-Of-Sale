<UserControl x:Class="PointOfSale.App.Views.QueueSyncStatusView"
             x:Name="QueueSyncRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PointOfSale.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
            <Border Background="#FEF3C7" Padding="12" Margin="4" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="PENDING" FontWeight="Bold" />
                    <TextBlock Text="{Binding PendingCount}" FontSize="24" />
                </StackPanel>
            </Border>
            <Border Background="#DBEAFE" Padding="12" Margin="4" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="SYNCING" FontWeight="Bold" />
                    <TextBlock Text="{Binding SyncingCount}" FontSize="24" />
                </StackPanel>
            </Border>
            <Border Background="#FEE2E2" Padding="12" Margin="4" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="QUARANTINED" FontWeight="Bold" />
                    <TextBlock Text="{Binding QuarantinedCount}" FontSize="24" />
                </StackPanel>
            </Border>
            <Border Background="#DCFCE7" Padding="12" Margin="4" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="SYNCED" FontWeight="Bold" />
                    <TextBlock Text="{Binding SyncedCount}" FontSize="24" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Status filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="160"
                      ItemsSource="{Binding StatusFilterOptions}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      Padding="8,4"
                      Margin="0,0,16,0" />
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Padding="10,8"
                    Margin="0,0,8,0" />
            <Button Content="Sync Next FIFO Item"
                    Command="{Binding SyncNextCommand}"
                    Padding="10,8"
                    FontWeight="SemiBold"
                    Margin="0,0,8,0" />
            <Button Content="Fix Receipt IDs"
                    Command="{Binding FixReceiptIdsCommand}"
                    Padding="10,8"
                    FontWeight="SemiBold"
                    ToolTip="Rewrite bad invoice numbers, release stuck/quarantined items, and archive receipts older than the 72h offline limit" />
        </StackPanel>

        <!--
          Toolbar actions target the grid's SelectedItem (visual highlight).
          Binding CommandParameter to QueueGrid.SelectedItem keeps the command in sync
          with the highlighted row even if the VM property briefly lags.
        -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Print Receipt"
                    Command="{Binding PrintReceiptCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=QueueGrid}"
                    Padding="10,8"
                    Margin="0,0,8,0"
                    FontWeight="SemiBold"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="Print the selected queue invoice receipt" />
            <Button Content="Retry"
                    Command="{Binding RetryQuarantinedCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=QueueGrid}"
                    Padding="10,8"
                    Margin="0,0,8,0"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="Return quarantined item to PENDING and submit to MRA immediately" />
            <Button Content="Force Sync"
                    Command="{Binding ForceSyncCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=QueueGrid}"
                    Padding="10,8"
                    FontWeight="SemiBold"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="Immediately submit the selected pending/quarantined item to MRA" />
        </StackPanel>

        <DataGrid x:Name="QueueGrid"
                  Grid.Row="3"
                  ItemsSource="{Binding QueueItems}"
                  SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsSynchronizedWithCurrentItem="True"
                  SelectionChanged="QueueGrid_OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="160" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="160" />
                <DataGridTextColumn Header="Retries" Binding="{Binding RetryCount}" Width="70" />
                <DataGridTextColumn Header="Next Retry" Binding="{Binding NextRetryTime}" Width="160" />
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*" />
                <DataGridTemplateColumn Header="Row Actions" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:QueueItemViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <!--
                                  Bind via DataGrid ancestor (visual tree). ElementName often fails inside
                                  DataTemplate name scopes; RelativeSource AncestorType=UserControl is also unreliable.
                                -->
                                <Button Content="Print Receipt"
                                        Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,4,0"
                                        Padding="6,2"
                                        FocusVisualStyle="{x:Null}"
                                        IsEnabled="{Binding CanPrintReceipt}"
                                        ToolTip="Print this invoice receipt"
                                        Click="RowActionButton_OnClick" />
                                <Button Content="Retry"
                                        Command="{Binding DataContext.RetryQuarantinedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,4,0"
                                        Padding="6,2"
                                        FocusVisualStyle="{x:Null}"
                                        IsEnabled="{Binding CanRetry}"
                                        ToolTip="Retry quarantined item now (submit to MRA)"
                                        Click="RowActionButton_OnClick" />
                                <Button Content="Force Sync"
                                        Command="{Binding DataContext.ForceSyncCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2"
                                        FocusVisualStyle="{x:Null}"
                                        IsEnabled="{Binding CanForceSync}"
                                        ToolTip="Force immediate MRA sync for this item"
                                        Click="RowActionButton_OnClick" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
