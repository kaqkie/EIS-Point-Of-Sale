<UserControl x:Class="PointOfSale.App.Views.QueueSyncStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
            <Border Background="#FEF3C7" Padding="12" Margin="4" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="PENDING" FontWeight="Bold" />
                    <TextBlock Text="{Binding PendingCount}" FontSize="24" />
                </StackPanel>
            </Border>
            <Border Background="#DBEAFE" Padding="12" Margin="4" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="SYNCING" FontWeight="Bold" />
                    <TextBlock Text="{Binding SyncingCount}" FontSize="24" />
                </StackPanel>
            </Border>
            <Border Background="#FEE2E2" Padding="12" Margin="4" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="QUARANTINED" FontWeight="Bold" />
                    <TextBlock Text="{Binding QuarantinedCount}" FontSize="24" />
                </StackPanel>
            </Border>
            <Border Background="#DCFCE7" Padding="12" Margin="4" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="SYNCED" FontWeight="Bold" />
                    <TextBlock Text="{Binding SyncedCount}" FontSize="24" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Padding="10,8"
                    Margin="0,0,8,0" />
            <Button Content="Sync Next FIFO Item"
                    Command="{Binding SyncNextCommand}"
                    Padding="10,8"
                    FontWeight="SemiBold" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding QueueItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="160" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="160" />
                <DataGridTextColumn Header="Retries" Binding="{Binding RetryCount}" Width="70" />
                <DataGridTextColumn Header="Next Retry" Binding="{Binding NextRetryTime}" Width="160" />
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*" />
                <DataGridTemplateColumn Header="Actions" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Retry"
                                        Command="{Binding DataContext.RetryQuarantinedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,4,0"
                                        Padding="6,2" />
                                <Button Content="Print"
                                        Command="{Binding DataContext.PrintSyncedReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
