<UserControl x:Class="PointOfSale.App.Views.BackupRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Disaster Recovery &amp; Backups"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="#4B5563"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Backup Now"
                            Command="{Binding BackupNowCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            FontWeight="Bold"
                            IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Last backup (UTC)" Foreground="#6B7280" />
                        <TextBlock Text="{Binding LastBackupTime, StringFormat=g, TargetNullValue=Never}"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding IsBackingUp, StringFormat='Backing up: {0}'}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Latest backup file" Foreground="#6B7280" />
                        <TextBlock Text="{Binding BackupFilePath, TargetNullValue=None}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Backup directory" Foreground="#6B7280" />
                        <TextBlock Text="{Binding BackupDirectory}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="#FEF2F2" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Last error" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastError, TargetNullValue=None}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Restore from snapshot" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SelectedBackupPath, TargetNullValue='No .bak selected'}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="#4B5563" />
                    <WrapPanel>
                        <Button Content="Browse .bak…"
                                Command="{Binding BrowseBackupCommand}"
                                Padding="12,8"
                                Margin="0,0,8,8"
                                MinHeight="40" />
                        <Button Content="Verify Integrity"
                                Command="{Binding VerifyBackupCommand}"
                                Padding="12,8"
                                Margin="0,0,8,8"
                                MinHeight="40" />
                        <CheckBox Content="I confirm destructive restore (overwrites local DB)"
                                  IsChecked="{Binding ConfirmRestore}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,8" />
                        <Button Content="Restore Database"
                                Command="{Binding RestoreCommand}"
                                Padding="12,8"
                                Margin="0,0,8,8"
                                MinHeight="40"
                                FontWeight="Bold"
                                Background="#FEE2E2" />
                    </WrapPanel>
                    <TextBlock Text="{Binding IsRestoring, StringFormat='Restore in progress: {0}'}"
                               Foreground="#B91C1C"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Backup history"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding History}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="260"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When (UTC)" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="140" />
                            <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="100" />
                            <DataGridTextColumn Header="Size" Binding="{Binding BackupBytes, StringFormat=N0}" Width="90" />
                            <DataGridTextColumn Header="OK" Binding="{Binding Success}" Width="50" />
                            <DataGridTextColumn Header="Path" Binding="{Binding BackupFilePath}" Width="*" />
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Use"
                                                Command="{Binding DataContext.UseHistoryBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Activity log"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding ActivityLog}"
                             MinHeight="160"
                             MaxHeight="280"
                             BorderThickness="0" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
