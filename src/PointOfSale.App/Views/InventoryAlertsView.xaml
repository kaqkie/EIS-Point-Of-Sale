<UserControl x:Class="PointOfSale.App.Views.InventoryAlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Inventory Stock Alerts"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Purchase Orders"
                            Command="{Binding OpenPurchaseOrdersCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Scan now"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Low stock" Foreground="#6B7280" />
                        <TextBlock Text="{Binding LowStockCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FEE2E2" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Stockouts" Foreground="#6B7280" />
                        <TextBlock Text="{Binding StockoutCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#DBEAFE" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Fast moving" Foreground="#6B7280" />
                        <TextBlock Text="{Binding FastMovingCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#E5E7EB" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Overstock" Foreground="#6B7280" />
                        <TextBlock Text="{Binding OverstockCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <WrapPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <TextBlock Text="Search" />
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,12,8">
                        <TextBlock Text="Alert type" />
                        <ComboBox ItemsSource="{Binding AlertTypeFilters}"
                                  SelectedItem="{Binding SelectedAlertTypeFilter}"
                                  MinHeight="36" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,12,8">
                        <TextBlock Text="Supplier filter" />
                        <ComboBox ItemsSource="{Binding SupplierFilters}"
                                  SelectedItem="{Binding SelectedSupplierFilter}"
                                  MinHeight="36" />
                    </StackPanel>
                    <Button Content="Acknowledge"
                            Command="{Binding AcknowledgeSelectedCommand}"
                            MinHeight="40"
                            Padding="12,8"
                            Margin="0,16,8,8"
                            VerticalAlignment="Bottom" />
                    <Button Content="Ack all"
                            Command="{Binding AcknowledgeAllCommand}"
                            MinHeight="40"
                            Padding="12,8"
                            Margin="0,16,0,8"
                            VerticalAlignment="Bottom" />
                </WrapPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Open alerts" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding LowStockItemsList}"
                                  SelectedItem="{Binding SelectedAlert}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80" />
                                <DataGridTextColumn Header="Type" Binding="{Binding AlertType}" Width="100" />
                                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="100" />
                                <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="On hand" Binding="{Binding StockQuantity, StringFormat=N2}" Width="80" />
                                <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdQty, StringFormat=N2}" Width="80" />
                                <DataGridTextColumn Header="Avg/day" Binding="{Binding AverageDailySales, StringFormat=N2}" Width="70" />
                                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierCode}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Reorder settings" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Product" Foreground="#6B7280" />
                        <TextBox Text="{Binding EditProductCode}" IsReadOnly="True" MinHeight="36" Margin="0,0,0,8" />
                        <TextBlock Text="Min reorder qty" Foreground="#6B7280" />
                        <TextBox Text="{Binding EditMinReorderQty, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,0,0,8" />
                        <TextBlock Text="Max capacity (0=uncapped)" Foreground="#6B7280" />
                        <TextBox Text="{Binding EditMaxStockCapacity, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,0,0,8" />
                        <TextBlock Text="Supplier code" Foreground="#6B7280" />
                        <TextBox Text="{Binding EditSupplierCode, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,0,0,8" />
                        <TextBlock Text="Supplier name" Foreground="#6B7280" />
                        <TextBox Text="{Binding EditSupplierName, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,0,0,8" />
                        <Button Content="Save thresholds"
                                Command="{Binding SaveThresholdsCommand}"
                                MinHeight="40"
                                Padding="12,8" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
