<UserControl x:Class="PointOfSale.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh Local"
                    Command="{Binding RefreshCommand}"
                    Padding="12,8"
                    Margin="0,0,8,0" />
            <Button Content="Sync Warehouse (MRA)"
                    Command="{Binding SyncWarehouseCommand}"
                    Padding="12,8"
                    FontWeight="SemiBold" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="120" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90" />
                <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, StringFormat=N2}" Width="90" />
                <DataGridTextColumn Header="HS" Binding="{Binding HsCode}" Width="90" />
                <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0" />
    </Grid>
</UserControl>
