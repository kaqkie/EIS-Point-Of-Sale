<UserControl x:Class="PointOfSale.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh Local"
                    Style="{StaticResource Art.Button.Secondary}"
                    Command="{Binding RefreshCommand}"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
            <Button Content="Sync EIS Products"
                    Style="{StaticResource Art.Button.Primary}"
                    Command="{Binding SyncSiteProductsCommand}"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    FontWeight="SemiBold"
                    ToolTip="Pull products assigned to this terminal site from MRA EIS"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
            <Button Content="Sync Warehouse (MRA)"
                    Style="{StaticResource Art.Button.Secondary}"
                    Command="{Binding SyncWarehouseCommand}"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
            <Button Content="Load demo catalog"
                    Style="{StaticResource Art.Button.Ghost}"
                    Command="{Binding LoadDemoCatalogCommand}"
                    Padding="12,8"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource Art.Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Add product"
                           Style="{StaticResource Art.Text.Title}"
                           FontSize="16"
                           Margin="0,0,0,4" />
                <TextBlock Text="Unit price is VAT-inclusive (shelf price), same as MRA EIS. Example: 20,000.00 → taxable 17,021.28 + VAT 2,978.72."
                           Style="{StaticResource Art.Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                        <TextBlock Text="Product code / barcode" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewProductCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 MinHeight="36" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Name" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 MinHeight="36" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,8">
                        <TextBlock Text="Description (MRA)" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewProductDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 MinHeight="36"
                                 ToolTip="Fiscal description for MRA register; defaults to name when blank" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="6" Margin="0,0,0,8">
                        <TextBlock Text="Price (incl. VAT)" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewUnitPriceText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 MinHeight="36" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                        <TextBlock Text="HS code" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewHsCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 MinHeight="36" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="UOM" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewUnitOfMeasure, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 MinHeight="36" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,8">
                        <TextBlock Text="Tax rate" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewTaxRateId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 MinHeight="36"
                                 ToolTip="Usually A for standard VAT" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="6" Margin="0,0,0,8">
                        <TextBlock Text="Opening stock" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewOpeningStockText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Art.TextBox}"
                                 MinHeight="36" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Add to local catalog"
                            Style="{StaticResource Art.Button.Primary}"
                            Command="{Binding AddLocalProductCommand}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            ToolTip="Save product locally with VAT-inclusive shelf price" />
                    <Button Content="Register with MRA"
                            Style="{StaticResource Art.Button.Secondary}"
                            Command="{Binding RegisterProductWithMraCommand}"
                            Padding="14,8"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            ToolTip="Call MRA stock/add-product (requires HS code + synced reference caches)" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="140" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Price (incl. VAT)" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="HS" Binding="{Binding HsCode}" Width="90" />
                    <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="80" />
                    <DataGridTextColumn Header="Tax" Binding="{Binding TaxRateId}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="{StaticResource Art.Brush.Canvas}"
                    BorderBrush="{StaticResource Art.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MaxWidth="420">
                    <TextBlock Text="No inventory items"
                               Style="{StaticResource Art.Text.Title}"
                               FontSize="18"
                               Margin="0,0,0,8" />
                    <TextBlock Text="The local catalog is empty. Add a product above, sync EIS Products after terminal activation, or load the demo catalog for testing."
                               Style="{StaticResource Art.Text.Subtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource Art.Text.Subtitle}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
    </Grid>
</UserControl>
