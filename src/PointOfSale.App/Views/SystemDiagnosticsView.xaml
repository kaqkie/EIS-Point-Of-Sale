<UserControl x:Class="PointOfSale.App.Views.SystemDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="System Diagnostics"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding HealthSummary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Refresh logs"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsRunningDiagnostics, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Run diagnostics"
                            Command="{Binding RunDiagnosticsCommand}"
                            IsEnabled="{Binding IsRunningDiagnostics, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#ECFDF5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDatabaseHealthy}" Value="False">
                                    <Setter Property="Background" Value="#FEE2E2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Database" Foreground="#6B7280" />
                        <TextBlock Text="{Binding IsDatabaseHealthy, StringFormat=Healthy: {0}}" FontWeight="Bold" />
                        <TextBlock Text="{Binding DatabaseLatencyMs, StringFormat={}{0} ms}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MRA API" Foreground="#6B7280" />
                        <TextBlock Text="{Binding MraApiStatus}" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Available disk" Foreground="#6B7280" />
                        <TextBlock Text="{Binding AvailableDiskSpace}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#E5E7EB" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Thermal printer" Foreground="#6B7280" />
                        <TextBlock Text="{Binding PrinterStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <WrapPanel>
                    <StackPanel Width="180" Margin="0,0,12,8">
                        <TextBlock Text="Category" />
                        <ComboBox ItemsSource="{Binding CategoryFilters}"
                                  SelectedItem="{Binding SelectedCategoryFilter}"
                                  MinHeight="36" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,12,8">
                        <TextBlock Text="Severity" />
                        <ComboBox ItemsSource="{Binding SeverityFilters}"
                                  SelectedItem="{Binding SelectedSeverityFilter}"
                                  MinHeight="36" />
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <TextBlock Text="Search" />
                        <TextBox Text="{Binding LogSearchQuery, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Padding="8,6" />
                    </StackPanel>
                    <Button Content="Apply filter"
                            Command="{Binding FilterLogsCommand}"
                            MinHeight="40"
                            Padding="12,8"
                            Margin="0,16,0,8"
                            VerticalAlignment="Bottom" />
                </WrapPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Recent diagnostic / error logs"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding RecentErrorLogsList}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="460">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When (UTC)" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="130" />
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120" />
                            <DataGridTextColumn Header="Latency" Binding="{Binding LatencyMs}" Width="70" />
                            <DataGridTextColumn Header="HTTP" Binding="{Binding HttpStatus}" Width="70" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
