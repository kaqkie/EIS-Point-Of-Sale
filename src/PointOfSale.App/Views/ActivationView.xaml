<UserControl x:Class="PointOfSale.App.Views.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#ECFDF5" Offset="0" />
                <GradientStop Color="#FFFFFF" Offset="0.5" />
                <GradientStop Color="#E0F2FE" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-100,-60,0,0" Fill="#A7F3D0" Opacity="0.5" />
        <Ellipse Width="320" Height="320" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-80,-80" Fill="#BAE6FD" Opacity="0.55" />

        <Border Style="{StaticResource Art.Card}"
                Width="520"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="36">
            <StackPanel>
                <Border Background="{StaticResource Art.Brush.SuccessSoft}"
                        CornerRadius="12"
                        Padding="12,8"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16">
                    <TextBlock Text="MRA TERMINAL ACTIVATION"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{StaticResource Art.Brush.Success}" />
                </Border>

                <TextBlock Text="Activate this register"
                           Style="{StaticResource Art.Text.Hero}"
                           Margin="0,0,0,6" />
                <TextBlock Text="Enter the store activation key to call MRA EIS onboarding (activate-terminal + confirmation), store encrypted credentials, and unlock operator sign-in."
                           Style="{StaticResource Art.Text.Subtitle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />

                <TextBlock Text="Activation key" Style="{StaticResource Art.Text.Caption}" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,4">
                    <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Art.TextBox.LicenseKey}"
                             MaxLength="19"
                             CharacterCasing="Upper" />
                    <TextBlock Text="{Binding LicenseKeyPlaceholder}"
                               FontFamily="{StaticResource Art.Font.Mono}"
                               FontSize="18"
                               Foreground="{StaticResource Art.Brush.TextMuted}"
                               Opacity="0.55"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLicenseKeyEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <TextBlock Text="{Binding LicenseKeyFormatFeedback}"
                           Style="{StaticResource Art.Text.Caption}"
                           Foreground="{StaticResource Art.Brush.Danger}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasLicenseKeyFormatError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding LicenseKeyFormatFeedback}"
                           Style="{StaticResource Art.Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsLicenseKeyIncomplete, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Text="Enter the activation key from the MRA EIS Portal (XXXX-XXXX-XXXX-XXXX)."
                           Style="{StaticResource Art.Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <Button Content="Activate with MRA"
                        Style="{StaticResource Art.Button.Success}"
                        Command="{Binding ActivateCommand}"
                        IsEnabled="{Binding CanActivate}"
                        Margin="0,0,0,14" />

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Art.Text.Subtitle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding MaskedLicenseKey, StringFormat='Active key: {0}', TargetNullValue=''}"
                           Style="{StaticResource Art.Text.Caption}"
                           Margin="0,10,0,0" />
                <TextBlock Text="{Binding MraTerminalId, StringFormat='MRA terminal: {0}', TargetNullValue=''}"
                           Style="{StaticResource Art.Text.Caption}"
                           Margin="0,4,0,0" />
                <TextBlock Text="Sandbox/mock credentials stored (live EIS unavailable or returned a non-activation status)."
                           Style="{StaticResource Art.Text.Caption}"
                           Foreground="{StaticResource Art.Brush.AccentHover}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding UsedSandboxFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
