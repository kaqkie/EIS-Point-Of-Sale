<UserControl x:Class="PointOfSale.App.Views.EnterpriseMaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Enterprise Maintenance"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding TerminalFleetStatus}"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="Refresh metrics"
                        Command="{Binding RefreshMetricsCommand}"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        MinHeight="40" />
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CPU" Foreground="#6B7280" />
                        <TextBlock Text="{Binding CpuUsagePercentage, StringFormat={}{0:0.0}%}"
                                   FontSize="20"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#F0FDF4" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Memory" Foreground="#6B7280" />
                        <TextBlock Text="{Binding MemoryConsumptionMb, StringFormat={}{0} MB}"
                                   FontSize="20"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FFFBEB" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SQL latency" Foreground="#6B7280" />
                        <TextBlock Text="{Binding AverageQueryLatencyMs, StringFormat={}{0} ms}"
                                   FontSize="20"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#F5F3FF" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="UI FPS" Foreground="#6B7280" />
                        <TextBlock Text="{Binding UiFramesPerSecond, StringFormat={}{0:0.0}}"
                                   FontSize="20"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Remote maintenance (supervisor)"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <CheckBox Content="Supervisor override for index maintenance"
                      IsChecked="{Binding SupervisorOverride}"
                      Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,16">
                <Button Content="Clear caches"
                        Command="{Binding ClearCachesCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
                <Button Content="Reorganize SQL indexes"
                        Command="{Binding ReorganizeIndexesCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
                <Button Content="Renew MRA credentials"
                        Command="{Binding RenewCredentialsCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
                <Button Content="Flush telemetry"
                        Command="{Binding FlushTelemetryCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Margin="0,0,8,8"
                        Padding="12,8"
                        MinHeight="40" />
            </WrapPanel>

            <TextBlock Text="Terminal fleet"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding FleetRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      Margin="0,0,0,16"
                      MinHeight="120">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Terminal" Binding="{Binding TerminalId}" Width="*" />
                    <DataGridTextColumn Header="Branch" Binding="{Binding BranchId}" Width="80" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuUsagePercentage, StringFormat={}{0:0.0}}" Width="70" />
                    <DataGridTextColumn Header="Mem MB" Binding="{Binding MemoryConsumptionMb}" Width="70" />
                    <DataGridTextColumn Header="SQL ms" Binding="{Binding AverageQueryLatencyMs}" Width="70" />
                    <DataGridCheckBoxColumn Header="Local" Binding="{Binding IsLocalTerminal}" Width="50" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Recent maintenance actions"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding MaintenanceHistory}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      MinHeight="140">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Command" Binding="{Binding CommandType}" Width="160" />
                    <DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="40" />
                    <DataGridTextColumn Header="Duration ms" Binding="{Binding DurationMs}" Width="90" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
