<UserControl x:Class="PointOfSale.App.Views.BarcodePrintingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Barcode &amp; Label Printing"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ActiveTemplateDescription}"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               FontSize="12" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsPrinting, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Print batch"
                            Command="{Binding PrintBatchCommand}"
                            IsEnabled="{Binding IsPrinting, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,8"
                            MinHeight="40"
                            FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Estimated labels" Foreground="#6B7280" />
                        <TextBlock Text="{Binding EstimatedLabelCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#ECFDF5" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Qty / item" Foreground="#6B7280" />
                        <TextBox Text="{Binding QuantityPerItem, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="36"
                                 Margin="0,4,0,0"
                                 Padding="8,6" />
                    </StackPanel>
                </Border>
                <Border Background="#FEF3C7" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Template" Foreground="#6B7280" />
                        <ComboBox ItemsSource="{Binding TemplateTypes}"
                                  SelectedItem="{Binding SelectedTemplateType}"
                                  MinHeight="36"
                                  Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Product catalog" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DockPanel>
                                <Button Content="Add"
                                        Command="{Binding AddSelectedProductCommand}"
                                        DockPanel.Dock="Right"
                                        Padding="10,6"
                                        Margin="8,0,0,0" />
                                <Button Content="Add filtered"
                                        Command="{Binding AddAllFilteredCommand}"
                                        DockPanel.Dock="Right"
                                        Padding="10,6"
                                        Margin="8,0,0,0" />
                                <TextBox Text="{Binding ProductSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36"
                                         Padding="8,6" />
                            </DockPanel>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding CatalogProducts}"
                                  SelectedItem="{Binding SelectedCatalogProduct}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="110" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Selected products (batch)"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Content="Remove"
                                    Command="{Binding RemoveSelectedProductCommand}"
                                    Padding="10,6"
                                    Margin="12,0,0,0" />
                            <Button Content="Clear"
                                    Command="{Binding ClearBatchCommand}"
                                    Padding="10,6"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding SelectedProductsList}"
                                  SelectedItem="{Binding SelectedBatchProduct}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="110" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Net" Binding="{Binding UnitPrice, StringFormat=N2}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Label preview" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding PreviewPriceLine}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,8" />
                        <Border Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                MinHeight="140">
                            <Image Source="{Binding PreviewBarcodeImage}"
                                   Stretch="Uniform"
                                   MaxHeight="160" />
                        </Border>
                        <TextBlock Text="Printing uses ESC/POS when ThermalPrinter is enabled; otherwise the Windows print dialog."
                                   TextWrapping="Wrap"
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Recent label batches"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding RecentBatches}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchId}" Width="70" />
                            <DataGridTextColumn Header="Template" Binding="{Binding TemplateType}" Width="130" />
                            <DataGridTextColumn Header="Products" Binding="{Binding ProductCount}" Width="80" />
                            <DataGridTextColumn Header="Labels" Binding="{Binding LabelCount}" Width="70" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding OperatorUsername}" Width="120" />
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
