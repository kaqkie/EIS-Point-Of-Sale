<UserControl x:Class="PointOfSale.App.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="User Management"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Signed in as " />
                        <Run Text="{Binding CurrentOperator.DisplayName, TargetNullValue='—'}" FontWeight="SemiBold" />
                        <Run Text=" (" />
                        <Run Text="{Binding CurrentOperator.Role, TargetNullValue=''}" />
                        <Run Text=")" />
                    </TextBlock>
                </StackPanel>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Padding="12,8"
                        MinHeight="40" />
            </DockPanel>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Create operator" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <StackPanel Width="160" Margin="0,0,12,8">
                            <TextBlock Text="Username" />
                            <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Width="180" Margin="0,0,12,8">
                            <TextBlock Text="Display name" />
                            <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,12,8">
                            <TextBlock Text="Role" />
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding SelectedRole}"
                                      MinHeight="36" />
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,12,8">
                            <TextBlock Text="Password" />
                            <PasswordBox x:Name="NewPasswordBox"
                                         MinHeight="36"
                                         PasswordChanged="NewPasswordBox_OnPasswordChanged" />
                        </StackPanel>
                        <Button Content="Create"
                                Command="{Binding CreateUserCommand}"
                                MinHeight="40"
                                Padding="12,8"
                                Margin="0,16,0,8"
                                VerticalAlignment="Bottom" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Operators" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Operators}"
                                  SelectedItem="{Binding SelectedOperator}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding OperatorId}" Width="50" />
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="110" />
                                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                                <DataGridTextColumn Header="Last login" Binding="{Binding LastLoginAtUtc, StringFormat=g}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Edit selected" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Display name" />
                        <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,0,0,8" />
                        <TextBlock Text="Role" />
                        <ComboBox ItemsSource="{Binding RoleOptions}"
                                  SelectedItem="{Binding EditRole}"
                                  MinHeight="36"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="Active"
                                  IsChecked="{Binding EditIsActive}"
                                  Margin="0,0,0,12" />
                        <Button Content="Save changes"
                                Command="{Binding SaveSelectedCommand}"
                                MinHeight="40"
                                Padding="12,8"
                                Margin="0,0,0,16" />

                        <TextBlock Text="Reset password" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <PasswordBox x:Name="ResetPasswordBox"
                                     MinHeight="36"
                                     Margin="0,0,0,8"
                                     PasswordChanged="ResetPasswordBox_OnPasswordChanged" />
                        <Button Content="Reset password"
                                Command="{Binding ResetPasswordCommand}"
                                MinHeight="40"
                                Padding="12,8" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Security audit log" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding AuditEntries}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When (UTC)" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="140" />
                            <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120" />
                            <DataGridTextColumn Header="OK" Binding="{Binding Success}" Width="50" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
