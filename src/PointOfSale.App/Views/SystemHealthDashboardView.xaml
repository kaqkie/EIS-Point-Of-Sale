<UserControl x:Class="PointOfSale.App.Views.SystemHealthDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="System Health Dashboard"
                               Style="{StaticResource Art.Text.Title}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource Art.Text.Subtitle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding HealthSummary}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Art.Brush.TextPrimary}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding LastCheckedAtUtc, StringFormat='Last check (UTC): {0:g}', TargetNullValue='Last check: —'}"
                               Style="{StaticResource Art.Text.Caption}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource Art.Button.Secondary}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsRunningDiagnostics, Converter={StaticResource InverseBooleanConverter}}" />
                    <Button Content="Run diagnostic"
                            Command="{Binding RunDiagnosticsCommand}"
                            Style="{StaticResource Art.Button.Primary}"
                            Padding="12,8"
                            MinHeight="40"
                            FontWeight="Bold"
                            IsEnabled="{Binding IsRunningDiagnostics, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="5" Margin="0,0,0,12">
                <Border Background="{Binding DatabaseStatusBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,8,0"
                        BorderBrush="{StaticResource Art.Brush.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Database" Style="{StaticResource Art.Text.Caption}" />
                        <TextBlock Text="{Binding IsDatabaseHealthy, StringFormat=Healthy: {0}}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Art.Brush.TextPrimary}" />
                        <TextBlock Text="{Binding DatabaseLatencyMs, StringFormat={}{0} ms}"
                                   Style="{StaticResource Art.Text.Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{Binding InternetStatusBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,8,0"
                        BorderBrush="{StaticResource Art.Brush.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Internet" Style="{StaticResource Art.Text.Caption}" />
                        <TextBlock Text="{Binding IsInternetOnline, StringFormat=Online: {0}}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Art.Brush.TextPrimary}" />
                    </StackPanel>
                </Border>

                <Border Background="{Binding MraStatusBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,8,0"
                        BorderBrush="{StaticResource Art.Brush.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="MRA EIS API" Style="{StaticResource Art.Text.Caption}" />
                        <TextBlock Text="{Binding IsMraApiReachable, StringFormat=Reachable: {0}}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Art.Brush.TextPrimary}" />
                        <TextBlock Text="{Binding MraApiStatus}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Art.Text.Caption}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding MraPingMs, StringFormat={}{0} ms, TargetNullValue=—}"
                                   Style="{StaticResource Art.Text.Caption}" />
                    </StackPanel>
                </Border>

                <Border Background="{Binding DiskStatusBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,8,0"
                        BorderBrush="{StaticResource Art.Brush.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Disk free" Style="{StaticResource Art.Text.Caption}" />
                        <TextBlock Text="{Binding DiskSpaceFreeMb, StringFormat={}{0:N1} MB}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Art.Brush.TextPrimary}" />
                        <TextBlock Text="{Binding BackupVolumeFreeMb, StringFormat=Backup vol: {0:N1} MB}"
                                   Style="{StaticResource Art.Text.Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{Binding QueueStatusBrush}"
                        CornerRadius="8"
                        Padding="12"
                        BorderBrush="{StaticResource Art.Brush.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Sync queue" Style="{StaticResource Art.Text.Caption}" />
                        <TextBlock Text="{Binding ActiveSyncQueueCount}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Art.Brush.TextPrimary}" />
                        <TextBlock Text="{Binding PendingQueueCount, StringFormat=Pending: {0}}"
                                   Style="{StaticResource Art.Text.Caption}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding QuarantinedQueueCount, StringFormat=Quarantined: {0}}"
                                   Style="{StaticResource Art.Text.Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Art.Card}" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Active warnings"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource Art.Brush.TextPrimary}" />
                    <ListBox ItemsSource="{Binding WarningMessages}"
                             MinHeight="60"
                             MaxHeight="120" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Art.Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Automated health alerts"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource Art.Brush.TextPrimary}" />
                    <DataGrid ItemsSource="{Binding RecentAlerts}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="260"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When (UTC)"
                                                Binding="{Binding RaisedAtUtc, StringFormat=g}"
                                                Width="140" />
                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding Code}"
                                                Width="140" />
                            <DataGridTextColumn Header="Severity"
                                                Binding="{Binding Severity}"
                                                Width="90" />
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
