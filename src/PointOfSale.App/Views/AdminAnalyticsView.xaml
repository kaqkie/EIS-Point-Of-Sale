<UserControl x:Class="PointOfSale.App.Views.AdminAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Administrative Analytics"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="#4B5563"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <ComboBox ItemsSource="{Binding PeriodOptions}"
                              SelectedItem="{Binding SelectedPeriod}"
                              Width="120"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding RangeStart}"
                                Width="120"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                ToolTip="Range start (Custom period)" />
                    <DatePicker SelectedDate="{Binding RangeEnd}"
                                Width="120"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                ToolTip="Range end (Custom period)" />
                    <Button Content="Apply Range"
                            Command="{Binding ApplyDateRangeCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="12,8"
                            MinHeight="40" />
                </StackPanel>
            </DockPanel>

            <!-- KPI strip -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Gross sales" Foreground="#6B7280" />
                        <TextBlock Text="{Binding GrossSales, StringFormat=N2}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding SyncedInvoiceCount, StringFormat='{}{0} fiscalized invoices'}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="VAT collected" Foreground="#6B7280" />
                        <TextBlock Text="{Binding ActualVat, StringFormat=N2}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding ExpectedVat, StringFormat='Expected 17.5%: {0:N2}'}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="VAT variance" Foreground="#6B7280" />
                        <TextBlock Text="{Binding VatVariance, StringFormat=N2}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding IsTaxBalanced, StringFormat='Balanced: {0}'}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Queue health" Foreground="#6B7280" />
                        <TextBlock Text="{Binding PendingQueueCount, StringFormat='Pending {0}'}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding QuarantinedQueueCount, StringFormat='Quarantined {0}'}" FontSize="12" Foreground="#B91C1C" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Online vs offline-synced transparency -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Online gross" Foreground="#6B7280" />
                        <TextBlock Text="{Binding OnlineGrossSales, StringFormat=N2}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding OnlineInvoiceCount, StringFormat='{}{0} invoices'}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Offline-synced gross" Foreground="#6B7280" />
                        <TextBlock Text="{Binding OfflineSyncedGrossSales, StringFormat=N2}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding OfflineSyncedInvoiceCount, StringFormat='{}{0} invoices'}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Standard taxable" Foreground="#6B7280" />
                        <TextBlock Text="{Binding StandardTaxable, StringFormat=N2}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Zero / Exempt taxable" Foreground="#6B7280" />
                        <TextBlock Text="{Binding ZeroRatedTaxable, StringFormat='Zero: {0:N2}'}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExemptTaxable, StringFormat='Exempt: {0:N2}'}" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Hourly sales velocity" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding HourlySales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Height="14"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding Ratio}"
                                                     Margin="6,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value, StringFormat=N0}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Offline queue clearance (synced/hr)" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding QueueDrainage}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Height="14"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding Ratio}"
                                                     Margin="6,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Detail}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Quarantine failure frequency" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding QuarantineFrequency}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Height="14"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding Ratio}"
                                                     Margin="6,0"
                                                     Foreground="#B91C1C" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Detail}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Tax codes (standard / zero-rated / exempt)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Export Tax CSV" Command="{Binding ExportTaxCsvCommand}" Margin="0,0,8,0" Padding="10,6" />
                            <Button Content="Export Tax PDF" Command="{Binding ExportTaxPdfCommand}" Padding="10,6" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding TaxBuckets}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rate" Binding="{Binding TaxRateId}" Width="80" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
                            <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableTotal, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="VAT" Binding="{Binding VatCollected, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="Invoices" Binding="{Binding InvoiceCount}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Shift &amp; cash drawer" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding OpenShiftSummary}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ShiftMetricsSummary}"
                               Foreground="#4B5563"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap" />

                    <WrapPanel>
                        <StackPanel Margin="0,0,16,8" Width="160">
                            <TextBlock Text="Cashier" />
                            <TextBox Text="{Binding CashierName, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8" Width="120">
                            <TextBlock Text="Opening float" />
                            <TextBox Text="{Binding OpeningFloat, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <Button Content="Open Shift"
                                Command="{Binding OpenShiftCommand}"
                                MinHeight="40"
                                Padding="12,8"
                                Margin="0,16,16,8"
                                VerticalAlignment="Bottom" />
                    </WrapPanel>

                    <WrapPanel>
                        <StackPanel Margin="0,0,16,8" Width="120">
                            <TextBlock Text="Cash amount" />
                            <TextBox Text="{Binding CashMovementAmount, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8" Width="200">
                            <TextBlock Text="Reason" />
                            <TextBox Text="{Binding CashMovementReason, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <Button Content="Cash In" Command="{Binding CashInCommand}" MinHeight="40" Padding="12,8" Margin="0,16,8,8" />
                        <Button Content="Cash Out" Command="{Binding CashOutCommand}" MinHeight="40" Padding="12,8" Margin="0,16,8,8" />
                        <Button Content="Cash Drop" Command="{Binding CashDropCommand}" MinHeight="40" Padding="12,8" Margin="0,16,8,8" />
                    </WrapPanel>

                    <WrapPanel>
                        <StackPanel Margin="0,0,16,8" Width="140">
                            <TextBlock Text="Closing cash counted" />
                            <TextBox Text="{Binding ClosingCashCounted, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                        </StackPanel>
                        <Button Content="Close Shift (Z-Report)"
                                Command="{Binding CloseShiftCommand}"
                                MinHeight="40"
                                Padding="12,8"
                                Margin="0,16,8,8"
                                FontWeight="Bold" />
                        <Button Content="Export Z CSV" Command="{Binding ExportZReportCsvCommand}" MinHeight="40" Padding="12,8" Margin="0,16,8,8" />
                        <Button Content="Export Z PDF" Command="{Binding ExportZReportPdfCommand}" MinHeight="40" Padding="12,8" Margin="0,16,8,8" />
                    </WrapPanel>

                    <TextBlock Text="Fiscalized invoices in current shift" FontWeight="SemiBold" Margin="0,8,0,6" />
                    <DataGrid ItemsSource="{Binding FiscalInvoices}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                            <DataGridTextColumn Header="Tender" Binding="{Binding PaymentMethod}" Width="100" />
                            <DataGridTextColumn Header="Total" Binding="{Binding InvoiceTotal, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="VAT" Binding="{Binding TotalVat, StringFormat=N2}" Width="80" />
                            <DataGridTextColumn Header="Fiscal sig" Binding="{Binding FiscalSignature}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Recent shifts" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding RecentShifts}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding ShiftId}" Width="50" />
                            <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="*" />
                            <DataGridTextColumn Header="Opened" Binding="{Binding OpenedAtUtc, StringFormat=g}" Width="140" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                            <DataGridTextColumn Header="Variance" Binding="{Binding CashVariance, StringFormat=N2}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
