<UserControl x:Class="PointOfSale.App.Views.DatabaseBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Database Backup &amp; Disaster Recovery"
                               Style="{StaticResource Art.Text.Title}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Style="{StaticResource Art.Text.Subtitle}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            Margin="0,0,8,0" />
                    <Button Content="Backup Now"
                            Command="{Binding BackupNowCommand}"
                            Padding="12,8"
                            MinHeight="40"
                            FontWeight="Bold"
                            IsEnabled="{Binding IsBackupInProgress, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource Art.Card}" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Last backup (UTC)" Style="{StaticResource Art.Text.Caption}" />
                        <TextBlock Text="{Binding LastBackupTimestamp, StringFormat=g, TargetNullValue=Never}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Art.Brush.TextPrimary}" />
                        <TextBlock Text="{Binding IsBackupInProgress, StringFormat='In progress: {0}'}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Art.Card}" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Backup file location" Style="{StaticResource Art.Text.Caption}" />
                        <TextBlock Text="{Binding BackupFileLocation, TargetNullValue=None}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Art.Brush.TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Art.Card}" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Storage usage" Style="{StaticResource Art.Text.Caption}" />
                        <TextBlock Text="{Binding StorageUsageMb, StringFormat={}{0:N2} MB}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Art.Brush.TextPrimary}" />
                        <TextBlock Text="{Binding BackupDirectory}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource Art.Brush.TextSecondary}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Art.Brush.DangerSoft}"
                        CornerRadius="8"
                        Padding="12"
                        BorderBrush="{StaticResource Art.Brush.Danger}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Last error" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastError, TargetNullValue=None}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Art.Card}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Secure restore (hardware replacement)"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource Art.Brush.TextPrimary}" />
                    <TextBlock Text="{Binding SelectedBackupPath, TargetNullValue='No .bak selected'}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource Art.Brush.TextSecondary}" />
                    <WrapPanel>
                        <Button Content="Browse .bak…"
                                Command="{Binding BrowseBackupCommand}"
                                Padding="12,8"
                                Margin="0,0,8,8"
                                MinHeight="40" />
                        <Button Content="Verify Integrity"
                                Command="{Binding VerifyBackupCommand}"
                                Padding="12,8"
                                Margin="0,0,8,8"
                                MinHeight="40" />
                        <CheckBox Content="I confirm destructive restore (overwrites local PointOfSale DB)"
                                  IsChecked="{Binding ConfirmRestore}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,8" />
                        <Button Content="Restore Database"
                                Command="{Binding RestoreCommand}"
                                Padding="12,8"
                                Margin="0,0,8,8"
                                MinHeight="40"
                                FontWeight="Bold"
                                Background="{StaticResource Art.Brush.DangerSoft}"
                                IsEnabled="{Binding IsBackupInProgress, Converter={StaticResource InverseBooleanConverter}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding IsRestoring, StringFormat='Restore in progress: {0}'}"
                               Foreground="{StaticResource Art.Brush.Danger}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Art.Card}" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Backup history"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource Art.Brush.TextPrimary}" />
                    <DataGrid ItemsSource="{Binding History}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="260"
                              HeadersVisibility="Column"
                              MouseDoubleClick="OnHistoryDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When (UTC)"
                                                Binding="{Binding CreatedAtUtc, StringFormat=g}"
                                                Width="140" />
                            <DataGridTextColumn Header="Trigger"
                                                Binding="{Binding Trigger}"
                                                Width="100" />
                            <DataGridTextColumn Header="Size"
                                                Binding="{Binding BackupBytes, StringFormat=N0}"
                                                Width="90" />
                            <DataGridTextColumn Header="OK"
                                                Binding="{Binding Success}"
                                                Width="50" />
                            <DataGridTextColumn Header="Path"
                                                Binding="{Binding BackupFilePath}"
                                                Width="*" />
                            <DataGridTextColumn Header="Error"
                                                Binding="{Binding ErrorMessage}"
                                                Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Art.Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Status audit log"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource Art.Brush.TextPrimary}" />
                    <ListBox ItemsSource="{Binding StatusAuditLog}"
                             MaxHeight="180"
                             FontFamily="{StaticResource Art.Font.Mono}"
                             FontSize="12" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
