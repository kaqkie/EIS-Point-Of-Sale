<UserControl x:Class="PointOfSale.App.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="CheckoutView_OnLoaded"
             PreviewKeyDown="CheckoutView_OnPreviewKeyDown">
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding AddSelectedToCartCommand}" />
        <KeyBinding Key="F5" Command="{Binding TenderExactAmountCommand}" />
        <KeyBinding Key="F8" Command="{Binding OpenQueueStatusCommand}" />
        <KeyBinding Key="F9" Command="{Binding ReprintLastReceiptCommand}" />
        <KeyBinding Key="F12" Command="{Binding CompleteSaleCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Inventory search"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,6"
                               Foreground="{StaticResource Art.Brush.TextPrimary}" />
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 FontSize="16"
                                 Padding="10,10,40,10"
                                 Style="{StaticResource Art.TextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by product name, code, or HS code" />
                        <TextBlock Text="🔍"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontSize="14"
                                   IsHitTestVisible="False"
                                   Opacity="0.55" />
                    </Grid>
                    <TextBlock Text="{Binding InventorySearchHint}"
                               Style="{StaticResource Art.Text.Caption}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <Button Content="Add selected (F2)"
                            Command="{Binding AddSelectedToCartCommand}"
                            Style="{StaticResource Art.Button.Primary}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            MinHeight="40" />
                </StackPanel>

                <DataGrid x:Name="ProductList"
                          ItemsSource="{Binding FilteredProducts}"
                          SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          FontSize="14"
                          AlternatingRowBackground="#F8FAFC"
                          MouseDoubleClick="ProductList_OnMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="110" />
                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, StringFormat=N0}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" MaxHeight="420" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding CartItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      FontSize="14"
                      Margin="0,0,0,8"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                    <DataGridTextColumn Header="Disc" Binding="{Binding TotalDiscountNet, StringFormat=N2}" Width="70" />
                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel>
                        <TextBlock Text="{Binding CartSubtotal, StringFormat='Subtotal: {0:N2}'}" FontSize="16" />
                        <TextBlock Text="{Binding PromoDiscountTotal, StringFormat='Promo discount: {0:N2}'}"
                                   FontSize="14"
                                   Foreground="#047857"
                                   Visibility="{Binding ShowAdvancedCheckoutTools, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding LoyaltyDiscountMwk, StringFormat='Loyalty discount: {0:N2}'}"
                                   FontSize="14"
                                   Foreground="#1D4ED8"
                                   Visibility="{Binding ShowAdvancedCheckoutTools, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding CartTaxTotal, StringFormat='VAT (17.5%): {0:N2}'}" FontSize="16" />
                        <TextBlock Text="{Binding CartGrandTotal, StringFormat='Total: {0:N2}'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBlock Text="{Binding ChangeDue, StringFormat='Change: {0:N2}'}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#047857"
                                   Margin="0,0,0,8" />

                        <WrapPanel Margin="0,0,0,8"
                                   Visibility="{Binding ShowAdvancedCheckoutTools, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox Width="140"
                                     MinHeight="36"
                                     Margin="0,0,8,4"
                                     Text="{Binding LoyaltyMemberCode, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Loyalty member code" />
                            <Button Content="Attach Member"
                                    Command="{Binding AttachLoyaltyMemberCommand}"
                                    MinHeight="36"
                                    Padding="10,6"
                                    Margin="0,0,8,4" />
                            <TextBox Width="80"
                                     MinHeight="36"
                                     Margin="0,0,8,4"
                                     Text="{Binding PointsToRedeem, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Points to redeem" />
                            <Button Content="Apply Points"
                                    Command="{Binding PreviewLoyaltyRedeemCommand}"
                                    MinHeight="36"
                                    Padding="10,6"
                                    Margin="0,0,8,4" />
                            <Button Content="Apply Promos"
                                    Command="{Binding ApplyPromotionsCommand}"
                                    MinHeight="36"
                                    Padding="10,6"
                                    Margin="0,0,8,4" />
                        </WrapPanel>
                        <TextBlock Text="{Binding AttachedMember.FullName, StringFormat='Member: {0}', TargetNullValue='Member: none'}"
                                   FontSize="12"
                                   Margin="0,0,0,4"
                                   Visibility="{Binding ShowAdvancedCheckoutTools, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding AvailablePoints, StringFormat='Available points: {0:N2}'}"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding ShowAdvancedCheckoutTools, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Payment:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="160"
                                      MinHeight="40"
                                      ItemsSource="{Binding PaymentMethodOptions}"
                                      SelectedItem="{Binding PaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Tendered:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="TenderBox"
                                     Width="160"
                                     MinHeight="40"
                                     FontSize="16"
                                     Style="{StaticResource Art.TextBox}"
                                     Text="{Binding AmountTenderedText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Exact (F5)"
                                    Command="{Binding TenderExactAmountCommand}"
                                    MinHeight="40"
                                    MinWidth="100"
                                    Margin="8,0,0,0"
                                    Padding="12,8"
                                    FontSize="14" />
                        </StackPanel>

                        <WrapPanel>
                            <Button Content="Add Item (F2)"
                                    Command="{Binding AddSelectedToCartCommand}"
                                    MinHeight="48"
                                    MinWidth="140"
                                    Padding="14,10"
                                    FontSize="16"
                                    Margin="0,0,8,8" />
                            <Button Content="Complete Sale (F12)"
                                    Command="{Binding CompleteSaleCommand}"
                                    MinHeight="48"
                                    MinWidth="180"
                                    Padding="14,10"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Margin="0,0,8,8" />
                            <Button Content="Reprint (F9)"
                                    Command="{Binding ReprintLastReceiptCommand}"
                                    MinHeight="48"
                                    MinWidth="130"
                                    Padding="14,10"
                                    FontSize="16"
                                    Margin="0,0,8,8"
                                    Visibility="{Binding ShowAdvancedCheckoutTools, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Queue (F8)"
                                    Command="{Binding OpenQueueStatusCommand}"
                                    MinHeight="48"
                                    MinWidth="120"
                                    Padding="14,10"
                                    FontSize="16"
                                    Margin="0,0,8,8"
                                    Visibility="{Binding ShowAdvancedCheckoutTools, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,0"
                                    Visibility="{Binding ShowAdvancedCheckoutTools, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding PendingQueueCount, StringFormat='Pending sync: {0}'}"
                                       Margin="0,0,16,0"
                                       FontSize="13"
                                       Foreground="#B45309" />
                            <TextBlock Text="{Binding QuarantinedQueueCount, StringFormat='Quarantined: {0}'}"
                                       FontSize="13"
                                       Foreground="#B91C1C" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
