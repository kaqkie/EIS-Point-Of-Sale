{
  "ConnectionStrings": {
    "PosDatabase": "Server=.\\SQLEXPRESS;Database=PointOfSale;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "MraEis": {
    "Environment": "Sandbox",
    "SandboxBaseUrl": "https://dev-eis-api.mra.mw/api/v1/",
    "ProductionBaseUrl": "https://apis.mra.mw/api/v1/",
    "BaseUrl": "",
    "ProductId": "MRA-desktop/{your-product-guid}",
    "ProductVersion": "1.0.0",
    "HttpTimeoutSeconds": 60
  },
  "OfflineSync": {
    "PollIntervalSeconds": 15,
    "MaxRetryAttempts": 8,
    "BaseBackoffSeconds": 30,
    "MaxBackoffSeconds": 3600
  },
  "PosOperations": {
    "InventoryUploadBatchSize": 50,
    "AuditLogRetentionDays": 90,
    "SyncedInvoiceRetentionDays": 90
  },
  "TerminalDeployment": {
    "BranchId": "",
    "SiteId": "",
    "TerminalActivationCode": "",
    "RequireEncryptedSecrets": false,
    "FallbackTradingName": "Albert Retail Terminal"
  },
  "ThermalPrinter": {
    "Enabled": false,
    "ConnectionMode": "Spooler",
    "PaperWidthMm": 80,
    "PrinterName": "",
    "SerialPortName": "COM3",
    "BaudRate": 9600,
    "CharactersPerLine": 48,
    "PreferEscPos": true
  },
  "DatabaseBootstrap": {
    "Enabled": true,
    "TargetSchemaVersion": 15,
    "RequiredInstanceHint": ".\\SQLEXPRESS"
  },
  "ApplicationUpdate": {
    "Enabled": false,
    "FeedUrl": "",
    "CheckIntervalMinutes": 60,
    "StageOnlyDuringBusinessHours": true,
    "FeedAuthorizationHeader": "",
    "HttpTimeoutSeconds": 30
  },
  "HeadOfficeSync": {
    "Enabled": false,
    "BaseUrl": "https://hq.albertretail.local/",
    "UploadPath": "api/v1/branch/sync/upload",
    "CatalogDeltaPath": "api/v1/catalog/delta",
    "AuthorizationHeader": "",
    "PayloadEncryptionKeyBase64": "",
    "PollIntervalSeconds": 120,
    "HttpTimeoutSeconds": 45,
    "MaxBatchSize": 50,
    "BranchId": "",
    "TerminalId": ""
  },
  "DatabaseBackup": {
    "Enabled": true,
    "BackupDirectory": "",
    "RetentionCount": 14,
    "BackupAtMidnight": true,
    "BackupOnShiftClose": true,
    "UseCompression": true,
    "UseChecksum": true,
    "SchedulerPollMinutes": 5,
    "CommandTimeoutSeconds": 600,
    "SensitiveConfigKeys": [ "Mra.Jwt", "Mra.TerminalSecret", "Terminal.SecretKey" ]
  },
  "Authentication": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "DefaultAdminUsername": "admin",
    "DefaultAdminPassword": "ChangeMe!123",
    "DefaultAdminDisplayName": "Store Administrator"
  },
  "AuditLogging": {
    "EnableDatabaseAudit": true,
    "EnableFileAudit": true,
    "FileDirectory": "Logs/MraAudit",
    "RetainedFileDays": 14
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  }
}
