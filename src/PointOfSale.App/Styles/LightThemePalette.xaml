<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Albert Retail Terminal — Phase 31 creative light theme.
      Strictly light-mode: white canvases, soft surface cards, slate type, sky accents.
    -->

    <!-- Core palette -->
    <Color x:Key="Art.Color.Canvas">#FFFFFF</Color>
    <Color x:Key="Art.Color.Surface">#F4F6F9</Color>
    <Color x:Key="Art.Color.SurfaceElevated">#FFFFFF</Color>
    <Color x:Key="Art.Color.Border">#E2E8F0</Color>
    <Color x:Key="Art.Color.TextPrimary">#1E293B</Color>
    <Color x:Key="Art.Color.TextSecondary">#64748B</Color>
    <Color x:Key="Art.Color.TextMuted">#94A3B8</Color>
    <Color x:Key="Art.Color.Accent">#0284C7</Color>
    <Color x:Key="Art.Color.AccentHover">#0369A1</Color>
    <Color x:Key="Art.Color.AccentSoft">#E0F2FE</Color>
    <Color x:Key="Art.Color.Success">#10B981</Color>
    <Color x:Key="Art.Color.SuccessSoft">#D1FAE5</Color>
    <Color x:Key="Art.Color.Danger">#EF4444</Color>
    <Color x:Key="Art.Color.DangerSoft">#FEE2E2</Color>
    <Color x:Key="Art.Color.Warning">#F59E0B</Color>
    <Color x:Key="Art.Color.CashierRail">#0EA5E9</Color>
    <Color x:Key="Art.Color.AdminRail">#0284C7</Color>
    <Color x:Key="Art.Color.AdminRailDeep">#0C4A6E</Color>

    <SolidColorBrush x:Key="Art.Brush.Canvas" Color="{StaticResource Art.Color.Canvas}" />
    <SolidColorBrush x:Key="Art.Brush.Surface" Color="{StaticResource Art.Color.Surface}" />
    <SolidColorBrush x:Key="Art.Brush.SurfaceElevated" Color="{StaticResource Art.Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Art.Brush.Border" Color="{StaticResource Art.Color.Border}" />
    <SolidColorBrush x:Key="Art.Brush.TextPrimary" Color="{StaticResource Art.Color.TextPrimary}" />
    <SolidColorBrush x:Key="Art.Brush.TextSecondary" Color="{StaticResource Art.Color.TextSecondary}" />
    <SolidColorBrush x:Key="Art.Brush.TextMuted" Color="{StaticResource Art.Color.TextMuted}" />
    <SolidColorBrush x:Key="Art.Brush.Accent" Color="{StaticResource Art.Color.Accent}" />
    <SolidColorBrush x:Key="Art.Brush.AccentHover" Color="{StaticResource Art.Color.AccentHover}" />
    <SolidColorBrush x:Key="Art.Brush.AccentSoft" Color="{StaticResource Art.Color.AccentSoft}" />
    <SolidColorBrush x:Key="Art.Brush.Success" Color="{StaticResource Art.Color.Success}" />
    <SolidColorBrush x:Key="Art.Brush.SuccessSoft" Color="{StaticResource Art.Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Art.Brush.Danger" Color="{StaticResource Art.Color.Danger}" />
    <SolidColorBrush x:Key="Art.Brush.DangerSoft" Color="{StaticResource Art.Color.DangerSoft}" />
    <SolidColorBrush x:Key="Art.Brush.Warning" Color="{StaticResource Art.Color.Warning}" />
    <SolidColorBrush x:Key="Art.Brush.CashierRail" Color="{StaticResource Art.Color.CashierRail}" />
    <SolidColorBrush x:Key="Art.Brush.AdminRail" Color="{StaticResource Art.Color.AdminRail}" />
    <SolidColorBrush x:Key="Art.Brush.AdminRailDeep" Color="{StaticResource Art.Color.AdminRailDeep}" />

    <!-- Typography -->
    <FontFamily x:Key="Art.Font.Ui">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Art.Font.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

    <Style x:Key="Art.Text.Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Art.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Art.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Art.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextMuted}" />
    </Style>
    <Style x:Key="Art.Text.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
    </Style>

    <!-- Soft card -->
    <Style x:Key="Art.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Art.Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Art.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" Direction="270" Color="#0F172A" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary / secondary / danger buttons -->
    <Style x:Key="Art.Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Art.Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Art.Brush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Art.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Art.Button.Primary}">
        <Setter Property="Background" Value="{StaticResource Art.Brush.AccentSoft}" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.AccentHover}" />
    </Style>

    <Style x:Key="Art.Button.Success" TargetType="Button" BasedOn="{StaticResource Art.Button.Primary}">
        <Setter Property="Background" Value="{StaticResource Art.Brush.Success}" />
    </Style>

    <Style x:Key="Art.Button.Danger" TargetType="Button" BasedOn="{StaticResource Art.Button.Primary}">
        <Setter Property="Background" Value="{StaticResource Art.Brush.Danger}" />
    </Style>

    <Style x:Key="Art.Button.Ghost" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Art.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nav rail buttons — Cashier (sky) vs Admin (deep cyan) -->
    <Style x:Key="Art.Nav.Cashier" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Art.Brush.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Art.Nav.Admin" TargetType="Button" BasedOn="{StaticResource Art.Nav.Cashier}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0369A1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Art.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Art.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CaretBrush" Value="{StaticResource Art.Brush.Accent}" />
    </Style>

    <Style x:Key="Art.Badge.Success" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Art.Brush.SuccessSoft}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style x:Key="Art.Badge.Danger" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Art.Brush.DangerSoft}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
</ResourceDictionary>
