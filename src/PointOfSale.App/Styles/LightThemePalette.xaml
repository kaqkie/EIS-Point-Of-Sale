<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Albert Retail Terminal — Phase 31 creative light theme.
      Strictly light-mode: white canvases, soft surface cards, slate type, sky accents.
    -->

    <!-- Core palette -->
    <Color x:Key="Art.Color.Canvas">#FFFFFF</Color>
    <Color x:Key="Art.Color.Surface">#F4F6F9</Color>
    <Color x:Key="Art.Color.SurfaceElevated">#FFFFFF</Color>
    <Color x:Key="Art.Color.Border">#E2E8F0</Color>
    <Color x:Key="Art.Color.TextPrimary">#1E293B</Color>
    <Color x:Key="Art.Color.TextSecondary">#64748B</Color>
    <Color x:Key="Art.Color.TextMuted">#94A3B8</Color>
    <Color x:Key="Art.Color.Accent">#0284C7</Color>
    <Color x:Key="Art.Color.AccentHover">#0369A1</Color>
    <Color x:Key="Art.Color.AccentSoft">#E0F2FE</Color>
    <Color x:Key="Art.Color.Success">#10B981</Color>
    <Color x:Key="Art.Color.SuccessSoft">#D1FAE5</Color>
    <Color x:Key="Art.Color.Danger">#EF4444</Color>
    <Color x:Key="Art.Color.DangerSoft">#FEE2E2</Color>
    <Color x:Key="Art.Color.Warning">#F59E0B</Color>
    <Color x:Key="Art.Color.CashierRail">#0EA5E9</Color>
    <Color x:Key="Art.Color.AdminRail">#F0F9FF</Color>
    <Color x:Key="Art.Color.AdminRailDeep">#E0F2FE</Color>

    <SolidColorBrush x:Key="Art.Brush.Canvas" Color="{StaticResource Art.Color.Canvas}" />
    <SolidColorBrush x:Key="Art.Brush.Surface" Color="{StaticResource Art.Color.Surface}" />
    <SolidColorBrush x:Key="Art.Brush.SurfaceElevated" Color="{StaticResource Art.Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Art.Brush.Border" Color="{StaticResource Art.Color.Border}" />
    <SolidColorBrush x:Key="Art.Brush.TextPrimary" Color="{StaticResource Art.Color.TextPrimary}" />
    <SolidColorBrush x:Key="Art.Brush.TextSecondary" Color="{StaticResource Art.Color.TextSecondary}" />
    <SolidColorBrush x:Key="Art.Brush.TextMuted" Color="{StaticResource Art.Color.TextMuted}" />
    <SolidColorBrush x:Key="Art.Brush.Accent" Color="{StaticResource Art.Color.Accent}" />
    <SolidColorBrush x:Key="Art.Brush.AccentHover" Color="{StaticResource Art.Color.AccentHover}" />
    <SolidColorBrush x:Key="Art.Brush.AccentSoft" Color="{StaticResource Art.Color.AccentSoft}" />
    <SolidColorBrush x:Key="Art.Brush.Success" Color="{StaticResource Art.Color.Success}" />
    <SolidColorBrush x:Key="Art.Brush.SuccessSoft" Color="{StaticResource Art.Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Art.Brush.Danger" Color="{StaticResource Art.Color.Danger}" />
    <SolidColorBrush x:Key="Art.Brush.DangerSoft" Color="{StaticResource Art.Color.DangerSoft}" />
    <SolidColorBrush x:Key="Art.Brush.Warning" Color="{StaticResource Art.Color.Warning}" />
    <SolidColorBrush x:Key="Art.Brush.CashierRail" Color="{StaticResource Art.Color.CashierRail}" />
    <SolidColorBrush x:Key="Art.Brush.AdminRail" Color="{StaticResource Art.Color.AdminRail}" />
    <SolidColorBrush x:Key="Art.Brush.AdminRailDeep" Color="{StaticResource Art.Color.AdminRailDeep}" />

    <!-- Typography -->
    <FontFamily x:Key="Art.Font.Ui">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Art.Font.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

    <Style x:Key="Art.Text.Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Art.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Art.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Art.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextMuted}" />
    </Style>
    <Style x:Key="Art.Text.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
    </Style>

    <!-- Soft card -->
    <Style x:Key="Art.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Art.Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Art.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" Direction="270" Color="#0F172A" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Phase 37 — Global Button ControlTemplate hover contrast.
      Dark fills keep Foreground #FFFFFF; light fills keep #1E293B so label text never vanishes on IsMouseOver.
    -->
    <SolidColorBrush x:Key="Art.Brush.ButtonOnDark" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Art.Brush.ButtonOnLight" Color="#1E293B" />

    <!-- Implicit default button (unstyled Button usages inherit high-contrast hover) -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Art.Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Art.Brush.AccentHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#075985" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary / secondary / danger buttons -->
    <Style x:Key="Art.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Art.Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
    </Style>

    <Style x:Key="Art.Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Art.Brush.AccentSoft}" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnLight}" />
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Dark hover fill → force white label for WCAG contrast -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Art.Brush.AccentHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#075985" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Art.Button.Success" TargetType="Button" BasedOn="{StaticResource Art.Button.Primary}">
        <Setter Property="Background" Value="{StaticResource Art.Brush.Success}" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#059669" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#047857" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Art.Button.Danger" TargetType="Button" BasedOn="{StaticResource Art.Button.Primary}">
        <Setter Property="Background" Value="{StaticResource Art.Brush.Danger}" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DC2626" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#B91C1C" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Art.Button.Ghost" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnLight}" />
        <Setter Property="BorderBrush" Value="{StaticResource Art.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Light hover fill → force slate label for contrast -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Art.Brush.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnLight}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#BAE6FD" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnLight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nav rail buttons — Cashier (sky) vs Admin (deep cyan) -->
    <Style x:Key="Art.Nav.Cashier" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnLight}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Art.Brush.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnLight}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#BAE6FD" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Art.Nav.Admin" TargetType="Button" BasedOn="{StaticResource Art.Nav.Cashier}">
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="Accent"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="Transparent"
                                    Margin="-6,1,0,1" />
                            <ContentPresenter Margin="8,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource Art.Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#BAE6FD" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource Art.Brush.AccentHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.AccentHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Art.Nav.AdminSection" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.AccentHover}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="4,0,4,6" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style x:Key="Art.Nav.AdminGroup" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BorderBrush" Value="#C7E7FB" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Art.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.TextPrimary}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Art.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CaretBrush" Value="{StaticResource Art.Brush.Accent}" />
    </Style>

    <!-- Phase 41 — masked license key (XXXX-XXXX-XXXX-XXXX); danger border on format errors -->
    <Style x:Key="Art.TextBox.LicenseKey" TargetType="TextBox" BasedOn="{StaticResource Art.TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Mono}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MaxLength" Value="19" />
        <Setter Property="CharacterCasing" Value="Upper" />
        <Setter Property="ToolTip" Value="Format: XXXX-XXXX-XXXX-XXXX (A–Z / 0–9). Hyphens are inserted automatically." />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasLicenseKeyFormatError}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Art.Brush.Danger}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="{StaticResource Art.Brush.DangerSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Art.Badge.Success" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Art.Brush.SuccessSoft}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style x:Key="Art.Badge.Danger" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Art.Brush.DangerSoft}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Touch-optimized POS register buttons (flat, no focus ring) -->
    <Style x:Key="Art.Pos.TouchButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Art.Font.Ui}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
        <Setter Property="Background" Value="#334155" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Art.Pos.Keypad" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="MinWidth" Value="64" />
    </Style>

    <Style x:Key="Art.Pos.PayCash" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#059669" />
    </Style>
    <Style x:Key="Art.Pos.PayCredit" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#2563EB" />
    </Style>
    <Style x:Key="Art.Pos.PayOther" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#7C3AED" />
    </Style>
    <Style x:Key="Art.Pos.ActionPrint" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#0F766E" />
    </Style>
    <Style x:Key="Art.Pos.ActionVoid" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#DC2626" />
    </Style>
    <Style x:Key="Art.Pos.ActionRefund" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#EA580C" />
    </Style>
    <Style x:Key="Art.Pos.ActionGift" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#DB2777" />
    </Style>
    <Style x:Key="Art.Pos.ActionPaid" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#16A34A" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Art.Pos.ActionNav" TargetType="Button" BasedOn="{StaticResource Art.Pos.TouchButton}">
        <Setter Property="Background" Value="#475569" />
    </Style>
    <Style x:Key="Art.Pos.KeypadOk" TargetType="Button" BasedOn="{StaticResource Art.Pos.Keypad}">
        <Setter Property="Background" Value="#16A34A" />
        <Setter Property="Foreground" Value="{StaticResource Art.Brush.ButtonOnDark}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
</ResourceDictionary>
