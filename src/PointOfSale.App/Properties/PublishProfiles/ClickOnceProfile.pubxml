<?xml version="1.0" encoding="utf-8"?>
<!--
  Optional ClickOnce-style web deployment profile (.NET 8 publish).
  Usage:
    dotnet publish src\PointOfSale.App\PointOfSale.App.csproj -c Release /p:PublishProfile=ClickOnceProfile
  Host the contents of publish\ClickOnce\ on an internal HTTPS share / IIS site.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\publish\ClickOnce\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <InstallUrl>https://updates.albertretail.local/art/clickonce/</InstallUrl>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.*</ApplicationVersion>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <UseApplicationTrust>false</UseApplicationTrust>
    <PublishWizardCompleted>true</PublishWizardCompleted>
  </PropertyGroup>
</Project>
