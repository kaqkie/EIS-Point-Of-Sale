<?xml version="1.0" encoding="utf-8"?>
<!--
  Albert Retail Terminal — WiX Toolset v4/v5 MSI definition (Phase 10).
  Build via: Setup\Build-Installer.ps1
  Requires: WiX Toolset SDK (dotnet tool / NuGet WixToolset.Sdk)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Albert Retail Terminal"
           Manufacturer="Albert Retail"
           Version="$(var.ProductVersion)"
           UpgradeCode="B7E4C2A1-9F3D-4E8B-A6C5-1D2E3F4A5B6C"
           Scope="perMachine"
           Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Albert Retail Terminal is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://albertretail.local/support" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Detect SQL Server Express instance used by Albert Retail Terminal -->
    <Property Id="SQLEXPRESSINSTALLED">
      <RegistrySearch Id="FindSqlExpress"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Microsoft SQL Server\Instance Names\SQL"
                      Name="SQLEXPRESS"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR SQLEXPRESSINSTALLED"
            Message="Microsoft SQL Server Express (instance SQLEXPRESS) is required. Install SQL Express, then re-run this installer." />

    <Feature Id="ProductFeature" Title="Albert Retail Terminal" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="SqlScriptsComponents" />
      <ComponentGroupRef Id="FirewallHelperComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Albert Retail Terminal">
        <Directory Id="ScriptsFolder" Name="Scripts" />
        <Directory Id="SetupHelpersFolder" Name="Setup" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Albert Retail Terminal" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Harvested publish output (bind path set by Build-Installer.ps1 / wixproj) -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)**">
        <Exclude Files="$(var.PublishDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="SqlScriptsComponents" Directory="ScriptsFolder">
      <Component Id="Script_SetupDatabase" Guid="*">
        <File Id="File_SetupDatabase" Source="$(var.RepoRoot)Scripts\SetupDatabase.sql" KeyPath="yes" />
      </Component>
      <Component Id="Script_TaxRateId" Guid="*">
        <File Id="File_TaxRateId" Source="$(var.RepoRoot)Scripts\002_LocalInventory_TaxRateId.sql" />
      </Component>
      <Component Id="Script_FiscalResponse" Guid="*">
        <File Id="File_FiscalResponse" Source="$(var.RepoRoot)Scripts\003_OfflineInvoiceQueue_FiscalResponse.sql" />
      </Component>
      <Component Id="Script_ProductionMaintenance" Guid="*">
        <File Id="File_ProductionMaintenance" Source="$(var.RepoRoot)Scripts\003_ProductionMaintenance.sql" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="FirewallHelperComponents" Directory="SetupHelpersFolder">
      <Component Id="FirewallScript" Guid="*">
        <File Id="File_ConfigureFirewall" Source="$(var.RepoRoot)Setup\ConfigureFirewall.ps1" KeyPath="yes" />
      </Component>
      <Component Id="SignScript" Guid="*">
        <File Id="File_SignRelease" Source="$(var.RepoRoot)Setup\Sign-Release.ps1" />
      </Component>
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="Albert Retail Terminal"
                Description="MRA EIS Point of Sale"
                Target="[INSTALLFOLDER]AlbertRetailTerminal.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\AlbertRetail\AlbertRetailTerminal"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="ApplicationShortcutDesktop" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="ApplicationDesktopShortcut"
                Name="Albert Retail Terminal"
                Description="MRA EIS Point of Sale"
                Target="[INSTALLFOLDER]AlbertRetailTerminal.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\AlbertRetail\AlbertRetailTerminal"
                     Name="desktop"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Firewall rules: run Setup\ConfigureFirewall.ps1 elevated after install (or via Build-Installer.ps1 -ConfigureFirewall). -->
  </Package>
</Wix>
