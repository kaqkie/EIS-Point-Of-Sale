<?xml version="1.0" encoding="utf-8"?>
<!--
  Albert Retail Terminal — Phase 35 production MSI (WiX Toolset v4/v5).
  Bundles Release binaries, SQL scripts, LocalDB/Express helpers, Start Menu + Desktop shortcuts.
  Build: Setup\Build-Installer.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Albert Retail Terminal"
           Manufacturer="Albert Retail"
           Version="$(var.ProductVersion)"
           UpgradeCode="B7E4C2A1-9F3D-4E8B-A6C5-1D2E3F4A5B6C"
           Scope="perMachine"
           Language="1033">

    <SummaryInformation Description="Albert Retail Terminal — MRA EIS Point of Sale for Malawi retail counters"
                        Manufacturer="Albert Retail" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Albert Retail Terminal is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://albertretail.local/support" />
    <Property Id="ARPHELPLINK" Value="https://albertretail.local/support" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Detect SQL Server Express (named instance SQLEXPRESS) -->
    <Property Id="SQLEXPRESSINSTALLED">
      <RegistrySearch Id="FindSqlExpress"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Microsoft SQL Server\Instance Names\SQL"
                      Name="SQLEXPRESS"
                      Type="raw" />
    </Property>

    <!-- Detect SQL Server LocalDB (common retail laptop / thin-client footprint) -->
    <Property Id="SQLLOCALDBINSTALLED">
      <RegistrySearch Id="FindSqlLocalDb"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Microsoft SQL Server Local DB\Installed Versions"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR SQLEXPRESSINSTALLED OR SQLLOCALDBINSTALLED"
            Message="Microsoft SQL Server Express (SQLEXPRESS) or SQL Server LocalDB is required. Install SQL Express/LocalDB, then re-run this installer. See Setup\Bootstrap-SqlExpressOrLocalDb.ps1." />

    <Feature Id="ProductFeature" Title="Albert Retail Terminal" Level="1"
             Description="POS application, SQL scripts, and first-run helpers.">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="SqlScriptsComponents" />
      <ComponentGroupRef Id="FirewallHelperComponents" />
      <ComponentGroupRef Id="FirstRunHelperComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
      <ComponentRef Id="ProgramDataDirectories" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Albert Retail Terminal">
        <Directory Id="ScriptsFolder" Name="Scripts" />
        <Directory Id="SetupHelpersFolder" Name="Setup" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AlbertRetailDataFolder" Name="AlbertRetailTerminal">
        <Directory Id="ArtSecretsFolder" Name="Secrets" />
        <Directory Id="ArtBackupsFolder" Name="Backups" />
        <Directory Id="ArtLogsFolder" Name="Logs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Albert Retail Terminal" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Harvested publish output (bind path set by Build-Installer.ps1 / wixproj) -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)**">
        <Exclude Files="$(var.PublishDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- Ship full SQL script set for offline / disaster-recovery re-bootstrap -->
    <ComponentGroup Id="SqlScriptsComponents" Directory="ScriptsFolder">
      <Files Include="$(var.RepoRoot)Scripts\**\*.sql" />
    </ComponentGroup>

    <ComponentGroup Id="FirewallHelperComponents" Directory="SetupHelpersFolder">
      <Component Id="FirewallScript" Guid="*">
        <File Id="File_ConfigureFirewall" Source="$(var.RepoRoot)Setup\ConfigureFirewall.ps1" KeyPath="yes" />
      </Component>
      <Component Id="SignScript" Guid="*">
        <File Id="File_SignRelease" Source="$(var.RepoRoot)Setup\Sign-Release.ps1" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="FirstRunHelperComponents" Directory="SetupHelpersFolder">
      <Component Id="SqlBootstrapScript" Guid="*">
        <File Id="File_BootstrapSql"
              Source="$(var.RepoRoot)Setup\Bootstrap-SqlExpressOrLocalDb.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="FirstRunReadme" Guid="*">
        <File Id="File_FirstRunReadme" Source="$(var.RepoRoot)Setup\FIRST-RUN.md" />
      </Component>
    </ComponentGroup>

    <!-- Create ProgramData layout for secrets, backups, and logs -->
    <Component Id="ProgramDataDirectories" Directory="AlbertRetailDataFolder" Guid="*">
      <CreateFolder />
      <RegistryValue Root="HKLM"
                     Key="Software\AlbertRetail\AlbertRetailTerminal"
                     Name="ProgramDataRoot"
                     Type="string"
                     Value="[AlbertRetailDataFolder]"
                     KeyPath="yes" />
      <RegistryValue Root="HKLM"
                     Key="Software\AlbertRetail\AlbertRetailTerminal"
                     Name="InstallFolder"
                     Type="string"
                     Value="[INSTALLFOLDER]" />
    </Component>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="Albert Retail Terminal"
                Description="MRA EIS Point of Sale — Albert Retail Terminal"
                Target="[INSTALLFOLDER]AlbertRetailTerminal.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\AlbertRetail\AlbertRetailTerminal"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="ApplicationShortcutDesktop" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="ApplicationDesktopShortcut"
                Name="Albert Retail Terminal"
                Description="MRA EIS Point of Sale"
                Target="[INSTALLFOLDER]AlbertRetailTerminal.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\AlbertRetail\AlbertRetailTerminal"
                     Name="desktop"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Custom action: schedule SQL bootstrap helper hint (run elevated post-install if needed) -->
    <CustomAction Id="CA_OpenFirstRunReadme"
                  Directory="SetupHelpersFolder"
                  ExeCommand="cmd.exe /c start &quot;&quot; &quot;[SetupHelpersFolder]FIRST-RUN.md&quot;"
                  Execute="immediate"
                  Return="ignore"
                  Impersonate="yes" />
  </Package>
</Wix>
